---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "알면 맛있는 오사카 — 친구처럼 들려주는 오사카 음식·역사·골목 이야기",
  description = "스토리를 먼저 읽고 즐기는 오사카! 400년 음식·역사 화보 스토리텔링, 12월·연말연시 풍습(코모다루·그라코로), 89곳 엄선 맛집·명소 도감, 초보 생존 가이드와 스마트 찜 바구니"
} = Astro.props;

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://osaka-story.sonagicreative.workers.dev';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1E293B" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Open Graph / Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteOrigin}/`} />
    <meta property="og:image" content={`${siteOrigin}/images/city/hero-osaka.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- FOUC 방지: 큰 글씨 모드 초기 즉시 적용 -->
    <script is:inline>
      try {
        if (localStorage.getItem('osaka_large_text') === 'true') {
          document.documentElement.classList.add('large-text');
        }
      } catch (e) {}
    </script>
    
    <!-- Fonts: Pretendard Variable + Noto Serif KR + Shippori Mincho -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600;700&family=Noto+Serif+JP:wght@500;700&family=Shippori+Mincho:wght@500;600;700&display=swap" rel="stylesheet" />
    
    <style is:global>
      :root {
        --color-bg: #FBF8F3;
        --color-card: #FFFFFF;
        --color-text: #1E293B;
        --color-noren: #1E293B;
        --color-vermilion: #D63B22;
        --color-vermilion-text: #B52812;
        --color-border: #E2DDD3;
        --color-wood: #D4A373;
        --color-wood-dark: #8C531B;
        
        --font-sans: 'Pretendard Variable', 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
        --font-serif: 'Noto Serif KR', 'Shippori Mincho', 'Noto Serif JP', 'Batang', serif;
        
        --font-scale: 100%;
        --container-max: 1280px;
        --container-pad: clamp(16px, 4vw, 44px);
        --card-gap: clamp(16px, 2.2vw, 24px);
      }

      html.large-text {
        --font-scale: 112.5%;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        -webkit-tap-highlight-color: transparent;
      }

      html {
        font-size: var(--font-scale);
        -webkit-text-size-adjust: 100%;
      }

      body {
        font-family: var(--font-sans);
        font-weight: 400;
        background-color: var(--color-bg);
        color: var(--color-text);
        line-height: 1.72;
        letter-spacing: -0.01em;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        word-break: keep-all;
        overflow-wrap: break-word;
        overflow-x: clip;
        min-height: 100vh;
      }

      strong, b {
        font-weight: 600;
      }

      /* 배경 잔잔한 화지 질감 */
      body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        opacity: 0.02;
        pointer-events: none;
        background-image: radial-gradient(#1e293b 1px, transparent 1px);
        background-size: 18px 18px;
        z-index: 999;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font-family: inherit;
        cursor: pointer;
        border: none;
        background: none;
      }

      /* 모바일 ~ 태블릿 ~ 데스크톱 유동형 컨테이너 */
      .container {
        width: 100%;
        max-width: var(--container-max);
        margin: 0 auto;
        padding-left: var(--container-pad);
        padding-right: var(--container-pad);
      }

      /* 붉은 낙관 배지 (元祖, 名物, 老舗, 匠人) */
      .stamp-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: 0.76rem;
        line-height: 1;
        padding: 4px 8px;
        color: #D63B22;
        border: 1.5px solid #D63B22;
        border-radius: 4px;
        background: rgba(214, 59, 34, 0.06);
        letter-spacing: 0.5px;
        white-space: nowrap;
      }

      /* 파도(청해파) 디바이더 */
      .seigaiha-divider {
        height: 12px;
        background-image: radial-gradient(circle at 10px 0, transparent 8px, #D4A373 8px, #D4A373 9.5px, transparent 10px);
        background-size: 20px 12px;
        opacity: 0.38;
        margin: clamp(20px, 3vw, 36px) 0;
      }

      /* 큰 글씨 토글 */
      .large-text-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.76rem;
        padding: 5px 9px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: #FFFFFF;
        background: rgba(255, 255, 255, 0.12);
        white-space: nowrap;
        transition: all 0.2s ease;
      }
      @media (min-width: 640px) {
        .large-text-btn {
          font-size: 0.82rem;
          padding: 5px 12px;
        }
      }
      .large-text-btn.active {
        background: var(--color-vermilion);
        border-color: var(--color-vermilion);
        font-weight: 600;
      }

      /* 모달 열렸을 때 스크롤 잠금 */
      body.modal-open {
        overflow: hidden;
      }

      /* 스토리 페이지에서 점프 이동 시 가게 카드 강조 하이라이트 */
      .place-card.jump-highlight {
        outline: 3.5px solid #D63B22 !important;
        box-shadow: 0 0 0 8px rgba(214, 59, 34, 0.22), 0 12px 32px rgba(214, 59, 34, 0.28) !important;
        transform: translateY(-4px);
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
    </style>
  </head>
  <body>
    <slot />

    <!-- PWA Service Worker Registration & Legacy Cache Cleanup Script -->
    <script is:inline>
      if ('caches' in window) {
        caches.keys().then((keys) => {
          keys.forEach((key) => {
            if (key !== 'osaka-story-v8') {
              caches.delete(key);
            }
          });
        });
      }
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').then((reg) => {
            reg.update();
          }).catch((err) => {
            console.log('SW registration failed: ', err);
          });
        });
      }
    </script>
  </body>
</html>
