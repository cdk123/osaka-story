---
import type { Place } from '../data/types';

interface Props {
  place: Place;
  compact?: boolean;
}

const { place, compact = false } = Astro.props;

// 구글 공식 로컬 매장 정보 (Google Business Profile / Maps Place Info: 실제 사진·리뷰·영업시간·메뉴·개요) 직결 URL
const googleLocalInfoUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.googleQuery || (place.nameJa + ' ' + place.branchJa + ' ' + place.addressJa))}`;
---

<article class={`place-card ${compact ? 'compact' : ''}`} id={`card-${place.id}`} data-place-id={place.id} data-area={place.area} data-category={place.category} data-companions={place.companions.join(',')}>
  <!-- 카드 썸네일 & 상단 오버레이 (클릭 시 구글 공식 로컬 매장정보·실제사진 열람) -->
  <div class="card-media">
    <a
      href={googleLocalInfoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="media-photo-link"
      title={`${place.nameKo} — 구글 공식 로컬 매장 정보 및 실제 사진 보기`}
    >
      <img
        src={place.image}
        alt={`${place.nameKo} (${place.nameJa}) 공식·현지 대표 사진`}
        loading="lazy"
        class="place-img"
      />
      <span class="media-local-badge">🔍 구글 공식 매장정보 · 사진 ↗</span>
    </a>
    <div class="media-overlay-top">
      <span class="area-chip">{place.areaLabel}</span>
      <div class="stamp-group">
        {place.badges.map((badge) => (
          <span class="stamp-badge">{badge}</span>
        ))}
      </div>
    </div>
    <button
      type="button"
      class="btn-pick"
      data-pick-toggle={place.id}
      aria-label={`${place.nameKo} 찜하기 토글`}
    >
      <span class="heart-icon">♥</span>
    </button>
  </div>

  <!-- 카드 본문 정보 -->
  <div class="card-body">
    <!-- 3단 상호 표기: 한글명 / 일본어원어 + 지점 / 발음 -->
    <header class="place-header">
      <div class="title-row">
        <h3 class="place-name-ko">
          <a
            href={googleLocalInfoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="title-local-link"
            title={`${place.nameKo} 구글 공식 로컬 정보 보기`}
          >
            {place.nameKo}
            {place.branchKo && <span class="branch-ko">({place.branchKo})</span>}
          </a>
        </h3>
        <div class="rating-badge" title={`구글 로컬 평점 ${place.rating}`}>
          <span class="star">★</span>
          <span class="rate-val">{place.rating.toFixed(1)}</span>
        </div>
      </div>
      <div class="place-name-ja-row">
        <span class="place-name-ja">{place.nameJa} {place.branchJa}</span>
        <span class="place-name-kana">[{place.nameKana}]</span>
        {place.officialUrl && (
          <a
            href={place.officialUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="official-site-chip"
            title={`${place.nameKo} 공식 홈페이지 열기`}
          >
            🌐 공식 홈페이지 ↗
          </a>
        )}
      </div>
      <div class="station-walk">
        <span class="pin-icon">🚇</span>
        <span>{place.station}</span>
      </div>
    </header>

    <!-- 현장 생존 배지 (룸, 대기, 현금, 마감, 위탁수하물 등) -->
    <div class="survival-badges-list">
      {place.survivalBadges.map((badge) => (
        <span class={`survival-chip chip-${badge.type}`} title={badge.tooltip || badge.label}>
          {badge.label}
        </span>
      ))}
    </div>

    <!-- 대표 메뉴 & 가격대 -->
    <div class="menu-highlight">
      <strong class="menu-title">대표</strong>
      <span class="menu-desc">{place.signatureMenu}</span>
      {place.priceRange && <span class="price-range">({place.priceRange})</span>}
    </div>

    <!-- 스토리 & 꿀팁 요약 -->
    {!compact && (
      <div class="story-box">
        <p class="story-desc">{place.story}</p>
        {place.tip && (
          <div class="tip-box">
            <strong class="tip-label">💡 현장 꿀팁</strong>
            <span class="tip-content">{place.tip}</span>
          </div>
        )}
      </div>
    )}

    <!-- 핵심 액션 버튼군 -->
    <footer class="card-actions">
      <button
        type="button"
        class="action-btn btn-show-driver"
        data-open-driver-modal={place.id}
      >
        <span class="action-icon">🚕</span>
        <span class="action-text">기사님·직원 보여주기</span>
      </button>

      <a
        href={googleLocalInfoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="action-btn btn-google-map"
        title={`${place.nameKo} 구글 공식 로컬 매장정보 · 사진 · 리뷰 보기`}
      >
        <span class="action-icon">🏪</span>
        <span class="action-text">구글 공식 로컬 정보</span>
      </a>
    </footer>
  </div>
</article>

<style>
  .place-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
  }

  .place-card:hover {
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.1);
  }

  @media (min-width: 768px) {
    .place-card:hover {
      transform: translateY(-2px);
    }
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 800 / 520;
    height: auto;
    background: #E2E8F0;
    overflow: hidden;
    flex-shrink: 0;
  }

  .media-photo-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .media-local-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 6px;
    background: rgba(15, 23, 42, 0.82);
    color: #FFFFFF;
    backdrop-filter: blur(4px);
    z-index: 2;
    transition: background 0.15s ease;
  }

  .media-photo-link:hover .media-local-badge {
    background: var(--color-vermilion);
  }

  .title-local-link:hover {
    color: var(--color-vermilion-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .official-site-chip {
    display: inline-flex;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 4px;
    background: #F1F5F9;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    transition: all 0.15s ease;
  }

  .official-site-chip:hover {
    background: #1E293B;
    color: #FFFFFF;
    border-color: #1E293B;
  }

  .place-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .place-card:hover .place-img {
    transform: scale(1.03);
  }

  .media-overlay-top {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 2;
  }

  .area-chip {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(30, 41, 59, 0.88);
    color: #FFFFFF;
    backdrop-filter: blur(4px);
  }

  .stamp-group {
    display: flex;
    gap: 4px;
  }

  .btn-pick {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: #94A3B8;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    z-index: 2;
    transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .btn-pick:hover {
    transform: scale(1.1);
    color: #EF4444;
  }

  .btn-pick.picked {
    color: #D63B22;
    background: #FFFFFF;
  }

  .btn-pick.picked .heart-icon {
    transform: scale(1.15);
  }

  .card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 12px;
  }

  .place-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .place-name-ko {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0F172A;
    line-height: 1.3;
    letter-spacing: -0.3px;
  }

  .branch-ko {
    font-size: 0.85rem;
    font-weight: 500;
    color: #64748B;
    margin-left: 4px;
  }

  .rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    background: #FEF3C7;
    color: #92400E;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .star {
    color: #F59E0B;
  }

  .place-name-ja-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.82rem;
  }

  .place-name-ja {
    font-family: var(--font-serif);
    font-weight: 700;
    color: #334155;
  }

  .place-name-kana {
    color: #64748B;
  }

  .station-walk {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.78rem;
    color: #475569;
    margin-top: 2px;
  }

  /* 생존 칩 리스트 */
  .survival-badges-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .survival-chip {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    line-height: 1.4;
  }

  .chip-seat { background: #EEF2FF; color: #3730A3; border: 1px solid #C7D2FE; }
  .chip-wait { background: #FEF2F2; color: #991B1B; border: 1px solid #FECACA; }
  .chip-cash { background: #FFFBEB; color: #92400E; border: 1px solid #FDE68A; }
  .chip-time { background: #FFF1F2; color: #BE123C; border: 1px solid #FECDD3; }
  .chip-age { background: #F0FDF4; color: #166534; border: 1px solid #BBF7D0; }
  .chip-notice { background: #FEF3C7; color: #B45309; border: 1px solid #FCD34D; }
  .chip-hack { background: #F3E8FF; color: #6B21A8; border: 1px solid #E9D5FF; }

  /* 대표 메뉴 */
  .menu-highlight {
    background: #F8FAFC;
    border-left: 3px solid var(--color-vermilion);
    padding: 6px 10px;
    border-radius: 0 4px 4px 0;
    font-size: 0.82rem;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
  }

  .menu-title {
    color: var(--color-vermilion-text);
    font-weight: 700;
    font-size: 0.75rem;
  }

  .menu-desc {
    color: #1E293B;
    font-weight: 500;
  }

  .price-range {
    color: #64748B;
    font-size: 0.75rem;
    margin-left: auto;
  }

  /* 스토리 & 팁 */
  .story-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 2px;
  }

  .story-desc {
    font-size: 0.84rem;
    color: #334155;
    line-height: 1.55;
  }

  .tip-box {
    background: #FFFBEB;
    border: 1px dashed #FCD34D;
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 0.78rem;
    line-height: 1.5;
    color: #78350F;
  }

  .tip-label {
    font-weight: 700;
    display: inline-block;
    margin-right: 4px;
  }

  /* 버튼군 */
  .card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 8px 6px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    text-align: center;
    transition: all 0.15s ease;
  }

  .btn-show-driver {
    background: #1E293B;
    color: #FFFFFF;
    border: 1px solid #1E293B;
  }

  .btn-show-driver:hover {
    background: #0F172A;
  }

  .btn-google-map {
    background: #F1F5F9;
    color: #1E293B;
    border: 1px solid #CBD5E1;
  }

  .btn-google-map:hover {
    background: #E2E8F0;
    color: #0F172A;
  }

  .action-icon {
    font-size: 0.95rem;
    line-height: 1;
  }

  .action-text {
    white-space: nowrap;
    letter-spacing: -0.3px;
  }
</style>
