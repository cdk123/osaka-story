---
import { places } from '../data/places';
import PlaceCard from './PlaceCard.astro';

const placesMap = new Map(places.map(p => [p.id, p]));

const mcdMenuItems = [
  {
    id: 'gracoro-classic',
    badge: '12월 겨울의 상징 · NO.1',
    nameKo: '그라코로 (그라탕 고로케 버거)',
    nameJa: 'グラコロ',
    pronounce: '그라코로',
    price: '단품 ¥440 / 세트 ¥740 전후',
    period: '매년 11월 말 ~ 1월 초 겨울 한정',
    image: '/images/dec/mcd-gracoro.jpg',
    desc: '1993년 첫 출시 이후 일본인들에게 “그라코로를 먹어야 겨울과 연말이 온 것이 실감 난다”는 찬사를 받는 전설의 시즌 한정 버거입니다. 겉은 바삭한 빵가루 옷을 입히고 속에는 통새우와 마카로니가 들어간 부드럽고 뜨거운 화이트 크림 그라탕을 채웠으며, 일반 참깨번이 아닌 스팀으로 쪄내어 구름처럼 폭신한 버터 번으로 감쌌습니다.',
    orderJa: 'グラコロ セットをお願いします。'
  },
  {
    id: 'gracoro-demi',
    badge: '12월 스페셜 프리미엄 버전',
    nameKo: '농후 데미글라스 & 비프 그라코로',
    nameJa: '濃厚デミ＆タルタルグラコロ',
    pronounce: '노-코- 데미 그라코로',
    price: '단품 ¥490 / 세트 ¥790 전후',
    period: '12월 겨울 시즌 한정',
    image: '/images/dec/mcd-demi-gracoro.jpg',
    desc: '기본 그라코로 위에 매년 12월마다 새롭게 업그레이드되는 진한 비프 데미글라스 스튜 소스와 트러플·갈릭 타르타르 소스를 듬뿍 얹은 스페셜 에디션입니다. 화이트 크림 고로케의 고소함과 진한 경양식 데미글라스 소스가 어우러져 일본 양식당 고로케 정식을 먹는 듯한 깊은 풍미를 선사합니다.',
    orderJa: '濃厚デミのグラコロ セットをお願いします。'
  },
  {
    id: 'sankaku-chocopie',
    badge: '겨울 길거리 국민 간식',
    nameKo: '겨울 한정 삼각 초코파이 (흑 · 백 · 시즌맛)',
    nameJa: '三角チョコパイ 黒 / 季節限定',
    pronounce: '산카쿠 초코파이',
    price: '¥160 ~ ¥180',
    period: '늦가을 ~ 12월 말 겨울 한정',
    image: '/images/dec/mcd-chocopie.jpg',
    desc: '수십 겹으로 얇게 접어 바삭하게 튀겨낸 삼각형 페이스트리 파이 속에 아몬드 알갱이가 씹히는 진하고 따뜻한 초콜릿 크림(또는 화이트 크림·커스터드)이 용암처럼 들어 있는 겨울 대표 디저트입니다. 도톤보리나 우메다를 걷다가 추울 때 하나씩 사 먹기 최고입니다.',
    orderJa: '三角チョコパイを1つお願いします。'
  },
  {
    id: 'mcgriddles',
    badge: '아침 10:30까지 조식 한정 (朝マック)',
    nameKo: '맥그리들 소시지 에그 (메이플 팬케이크 번)',
    nameJa: 'マックグリドル ソーセージエッグ',
    pronounce: '마쿠그리도루 소-세-지 에구',
    price: '단품 ¥360 / 아침 콤비·세트 ¥420~¥560',
    period: '매일 오픈 ~ 오전 10:30 한정 (연말연시 아침 추천)',
    image: '/images/dec/mcd-mcgriddles.jpg',
    desc: '한국에서도 단종 후 재출시 요청이 끊이지 않는 일본 맥도날드 아침(아사마쿠) 부동의 1위 메뉴입니다. 달콤한 메이플 시럽 알갱이가 박힌 폭신한 핫케이크 번 사이에 짭조름한 소시지 패티, 계란, 체다치즈를 끼워 단짠단짠의 극치를 보여줍니다. 1월 1일 새해 첫날 아침 식사로도 강력 추천합니다.',
    orderJa: 'マックグリドル ソーセージエッグ セットをお願いします。'
  }
];

const newYearTimeline = [
  {
    step: 'STEP 01 · 12월 31일 오후 4시 ~ 밤 11시',
    tag: '12월 31일 (오미소카 大晦日)',
    title: '해넘이 메밀국수 ‘토시코시 소바’ & 백화점 데파치카 마감 세일',
    image: '/images/dec/dec-toshikoshi-soba.jpg',
    points: [
      '<strong>토시코시 소바(年越しそば)의 유래:</strong> ① 가늘고 긴 면발처럼 건강하게 장수하고, ② 다른 국수보다 툭 잘 끊어지는 메밀면처럼 올 한 해의 액운과 고생을 싹둑 끊어내며, ③ 옛 금은 세공 장인들이 메밀 반죽으로 금가루를 모았다는 데서 새해 금전운을 모은다는 뜻이 담겨 있습니다.',
      '<strong>12/31 오후 4~6시 백화점 지하(데파치카) 공략:</strong> 12월 31일에는 한큐·타카시마야·한신 백화점 지하 식품관이 <strong>오후 6시경 조기 폐점</strong>합니다! 마감 1~2시간 전에 방문하면 1년에 단 한 번 파는 일본 명절 찬합 요리 <strong>‘미니 오세치(おせち)’</strong>와 대왕 새우튀김 소바, 와규 스시 도시락을 할인가에 득템해 호텔에서 화려한 연말 파티를 즐길 수 있습니다.'
    ]
  },
  {
    step: 'STEP 02 · 12월 31일 밤 11시 ~ 1월 3일',
    tag: '새해 첫 참배 (하츠모데 初詣)',
    title: '스미요시 타이샤·오사카 텐만구 신년 참배 & 수백 개 야타이(포장마차) 축제',
    image: '/images/places/sumiyoshi-taisha-hatsumode.jpg',
    points: [
      '<strong>230만 명이 모이는 신년 대축제:</strong> 자정이 가까워지면 사찰에서 108번의 제야의 종(조야노 카네)이 울리고, 오사카 시민들은 1,800년 역사의 <strong>〈스미요시 타이샤〉</strong>와 학문의 신 <strong>〈오사카 텐만구〉</strong>로 새해 첫 참배(하츠모데)를 떠납니다.',
      '<strong>야타이(축제 포장마차) & 오미쿠지:</strong> 신사 앞 참배길에 수백 개의 전통 노점(베이비 카스테라, 사과사탕 링고아메, 야키소바, 타코야키, 따뜻한 감주 아마자케)이 들어서서 일본 영화 속 신년 마츠리 풍경이 그대로 펼쳐집니다. 동전(5엔 또는 50엔)을 던져 소원을 빌고 <strong>새해 운세 제비뽑기(오미쿠지, ¥200)</strong>를 꼭 뽑아보세요!'
    ]
  },
  {
    step: 'STEP 03 · 1월 1일(원단) ~ 1월 2일 아침',
    tag: '신년 첫 세일 (하츠우리 初売り & 福袋)',
    title: '🚨 1월 1일 백화점 휴무 생존법 & ‘후쿠부쿠로(복주머니)’ 오픈런',
    image: '/images/dec/dec-fukubukuro.jpg',
    points: [
      '<strong>1월 1일(원단, 元旦) 휴무 주의보:</strong> 1월 1일 당일에는 한큐·한신·타카시마야·다이마루 등 백화점과 개인 노포 식당들이 대부분 휴점합니다. 1월 1일에는 연중무휴로 문을 여는 <strong>도톤보리 대형 식당(카무쿠라·오사카 오쇼·보테쥬·치보·카니도라쿠)</strong>과 <strong>일본 명문 체인(야요이켄·코메다 커피·로얄호스트·맥도날드)</strong>, 그리고 스미요시 타이샤·미노오 폭포·소라니와 온천으로 동선을 짜세요!',
      '<strong>후쿠부쿠로(福袋, 복주머니) 전쟁:</strong> 빅카메라·돈키호테·이온몰 등은 <strong>1월 1일 아침</strong>부터, 주요 백화점들은 <strong>1월 2일 아침 오픈과 동시에</strong> 구매 가격의 2~3배 상품이 든 ‘후쿠부쿠로(복주머니 — 의류·문구·찻잎·화과자·가전·캐릭터 굿즈)’를 선착순 판매합니다!'
    ]
  },
  {
    step: 'STEP 04 · 12월 31일 자정 & 새해 첫날 아침의 전통 술 의식',
    tag: '연말연시 가족 술통 의식 (鏡開き・樽酒・お屠蘇)',
    title: '🍶 짚 감은 술통을 깨서 국자로 떠 마시는 ‘타루자케(코모다루) & 카가미비라키’와 새해 약주 ‘오토소’',
    image: '/images/dec/dec-komodaru.jpg',
    points: [
      '<strong>① 타루자케(樽酒) · 코모다루(菰樽)와 ‘카가미비라키(鏡開き)’:</strong> 일본에서 연말연시나 큰 경사 때 온 가족이 모여 <strong>짚을 두른 둥근 술 항아리·술통(코모다루)</strong>의 나무 뚜껑(보름달과 화합을 상징해 ‘거울 카가미 鏡’라 부름)을 나무 망치로 ‘팍!’ 쳐서 여는 의식을 <strong>‘카가미비라키(거울을 열어 복을 부른다)’</strong>라고 합니다. 삼나무 향이 배어든 사케를 긴 나무 국자(히샤쿠)로 떠서 네모난 편백나무 잔(<strong>마스 枡</strong>)에 담아 나누어 마십니다.',
      '<strong>② 호텔 객실에서 직접 해보는 ‘미니 코모다루(ミニ鏡開き)’ 구매 팁:</strong> 12월 말 백화점 지하 주류 매장(한큐·타카시마야)이나 난바 빅카메라 2층 주류 코너에 가면, 식탁에 올려놓고 <strong>미니 나무 망치로 직접 뚜껑을 깨고 국자로 떠 마실 수 있는 ‘가정용 미니 코모다루(300ml~1.8L)’</strong>를 연말연시 한정으로 판매합니다! 12월 31일 밤 호텔 방에서 해넘이 소바·오세치와 함께 뚜껑을 여는 순간 평생 잊지 못할 새해 추억이 됩니다.',
      '<strong>③ 새해 아침 가장 어린 사람부터 마시는 약주 ‘오토소(お屠蘇)’:</strong> 12월 31일 밤 사케와 미림에 계피·산초·진피 등 약재 주머니(토소산)를 담가 두었다가 1월 1일 아침에 마시는 무병장수 약주입니다. “어린 사람의 젊은 기운을 어른에게 전한다”는 뜻으로 <strong>가장 나이가 어린 사람부터 순서대로 연장자에게 잔을 돌리는 독특한 전통</strong>이 있습니다.'
    ]
  }
];

const winterFeaturedIds = [
  'sumiyoshi-taisha-hatsumode',
  'mcdonalds-japan-gracoro',
  'kamukura-ramen',
  'osaka-ohsho-gyoza',
  'yayoiken-kyk-teishoku',
  'komeda-royalhost',
  'takoume-honten',
  'hanakujira',
  'genpin-fugu',
  'kani-doraku',
  'harijyu',
  'soraniwa-onsen'
];

const winterPlaces = winterFeaturedIds
  .map(id => placesMap.get(id))
  .filter(Boolean);
---

<div class="december-view">
  <!-- 1. 12월 · 연말연시 메인 히어로 배너 -->
  <section class="dec-hero-card">
    <div class="dec-hero-visual">
      <img
        src="/images/dec/dec-midosuji-illum.jpg"
        alt="오사카 미도스지 일루미네이션 & 나카노시마 빛의 르네상스"
        class="dec-hero-img"
      />
      <div class="dec-hero-overlay">
        <div class="dec-badges">
          <span class="stamp-badge dec-stamp">十二月・年末年始 特集</span>
          <span class="dec-sub-pill">12월 겨울 한정판 · 12/31~1/3 완벽 공략</span>
        </div>
        <h2 class="dec-hero-title">12월 & 연말연시 오사카에만 있는 특별한 순간들</h2>
        <p class="dec-hero-lead">
          우메다에서 난바까지 4km를 수놓는 미도스지 일루미네이션, 겨울에만 파는 일본 맥도날드 ‘그라코로’, 12월 31일 밤의 해넘이 소바와 스미요시 타이샤 신년 포장마차 대축제, 그리고 1월 1일 휴무일에도 실패 없는 일본 명문 체인점까지 한눈에 정리했습니다.
        </p>
      </div>
    </div>

    <!-- 12월 겨울 일루미네이션 2대 핵심 요약 바 -->
    <div class="illum-strip-grid">
      <div class="illum-box">
        <span class="illum-badge">✨ 기네스 세계기록 인증</span>
        <strong class="illum-title">미도스지 일루미네이션 (11월~12월 31일)</strong>
        <p class="illum-desc">
          우메다(한큐백화점 앞)부터 신사이바시·난바까지 약 4km 대로를 따라 은행나무 수백 그루가 구간별 황금빛·샴페인골드·주홍빛 LED로 빛나는 오사카 겨울밤의 상징입니다. (점등: 17:00~23:00, 12월 31일은 새벽 01:00까지 특별 점등!)
        </p>
      </div>
      <div class="illum-box">
        <span class="illum-badge">🏛️ 수변 미디어 파사드 & 야시장</span>
        <strong class="illum-title">오사카 빛의 르네상스 (나카노시마 중앙공회당 · ~12월 25일/31일)</strong>
        <p class="illum-desc">
          1918년 지어진 붉은 벽돌 중앙공회당 외벽 전체에 화려한 빛의 예술을 투사하고, 나카노시마 강변 산책로를 따라 대만 지우펀풍 초롱불 터널과 겨울 야시장 푸드트럭이 열리는 로맨틱한 겨울 축제입니다.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. 일본 맥도날드(‘마쿠도’) 12월 겨울 한정판 4대 메뉴 실사 도감 -->
  <section class="mcd-special-section">
    <div class="sec-head-box">
      <div class="sec-kicker-row">
        <span class="stamp-badge">冬季限定 マクド</span>
        <span class="sec-kicker-text">한국 맥도날드에는 없는 일본 겨울 시즌 한정판</span>
      </div>
      <h3 class="sec-main-heading">🍔 일본 맥도날드(‘마쿠도’) 12월 한정판 4대 메뉴 실사 도감</h3>
      <p class="sec-main-sub">
        오사카 사람들은 맥도날드를 ‘마쿠도(マクド)’라 부릅니다. 12월 말~1월 초 오사카에 간다면 무조건 맛봐야 할 겨울 한정 메뉴 4가지와 일본어 주문 문구입니다.
      </p>
    </div>

    <div class="mcd-cards-grid">
      {mcdMenuItems.map((item) => (
        <article class="mcd-card">
          <div class="mcd-media">
            <img src={item.image} alt={item.nameKo} loading="lazy" class="mcd-img" />
            <span class="mcd-badge">{item.badge}</span>
          </div>
          <div class="mcd-body">
            <div class="mcd-titles">
              <h4 class="mcd-ko">{item.nameKo}</h4>
              <div class="mcd-ja-row">
                <span class="mcd-ja">{item.nameJa}</span>
                <span class="mcd-pronounce">[{item.pronounce}]</span>
              </div>
            </div>
            <div class="mcd-meta-row">
              <span class="mcd-meta-pill">🗓️ {item.period}</span>
              <span class="mcd-meta-pill price">💰 {item.price}</span>
            </div>
            <p class="mcd-desc">{item.desc}</p>
            <div class="mcd-order-box">
              <span class="order-label">👉 카운터·키오스크 주문 일본어</span>
              <strong class="order-ja">{item.orderJa}</strong>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

