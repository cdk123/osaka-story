<script is:inline>
  (function() {
    const tabBtns = document.querySelectorAll('.chapter-tab-btn');
    const panels = document.querySelectorAll('.story-chapter-panel');
    const toggleAllBtn = document.getElementById('btn-toggle-all-chapters');
    let isAllExpanded = false;

    function selectChapter(targetId, scrollToReader = true) {
      if (isAllExpanded) {
        const targetEl = document.getElementById(`story-panel-${targetId}`);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        return;
      }

      tabBtns.forEach(btn => {
        const active = btn.getAttribute('data-story-target') === targetId;
        btn.classList.toggle('active', active);
        if (active) {
          btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
      });

      panels.forEach(panel => {
        const match = panel.getAttribute('data-chapter-panel') === targetId;
        panel.classList.toggle('active-chapter', match);
        panel.classList.toggle('hidden-chapter', !match);
      });

      if (scrollToReader) {
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;
      }
    }

    document.addEventListener('click', (e) => {
      const targetBtn = e.target.closest('[data-story-target]');
      if (targetBtn) {
        const targetId = targetBtn.getAttribute('data-story-target');
        if (targetId) selectChapter(targetId, true);
      }
    });

    if (toggleAllBtn) {
      toggleAllBtn.addEventListener('click', () => {
        isAllExpanded = !isAllExpanded;
        if (isAllExpanded) {
          panels.forEach(p => {
            p.classList.add('active-chapter');
            p.classList.remove('hidden-chapter');
          });
          toggleAllBtn.textContent = '📕 한 장씩 책장 넘겨보기 모드로 전환';
          toggleAllBtn.classList.add('expanded');
        } else {
          toggleAllBtn.textContent = '📖 7개 장 전체 한꺼번에 펼치기';
          toggleAllBtn.classList.remove('expanded');
          const currentActive = document.querySelector('.chapter-tab-btn.active')?.getAttribute('data-story-target') || 'prologue';
          selectChapter(currentActive, false);
        }
      });
    }

    window.osakaSelectStoryChapter = selectChapter;
  })();
</script>

