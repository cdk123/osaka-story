---
import { stories } from '../data/stories';
import { places } from '../data/places';
import { specialThemes } from '../data/media';

// 빠른 ID 매핑 딕셔너리 생성
const placesMap = new Map(places.map(p => [p.id, p]));

// 각 챕터별 짧은 탭 이름 & 문단별 소제목·단락별 스토리 화보 사진 매핑
const chapterMeta: Record<string, {
  shortTab: string;
  heroImg: string;
  subheadings: string[];
  paraPhotos: { img: string; caption: string }[];
}> = {
  'prologue': {
    shortTab: '프롤로그 · 천하의 부엌',
    heroImg: '/images/city/hero-osaka.jpg',
    subheadings: [
      '“먹다가 집안이 거덜 난다” — 쿠이다오레(食い倒れ)의 탄생',
      '400년 전 전국의 산해진미가 모인 물길, 천하의 부엌',
      '체면의 도쿄 무사(사무라이) vs 실속의 오사카 상인(초닌)',
      '내 혀가 납득하는 진짜 맛에만 지갑을 여는 실리주의'
    ],
    paraPhotos: [
      { img: '/images/city/district-minami.jpg', caption: '400년 전 운하 개척으로 시작되어 오늘날까지 불야성을 이루는 미식의 심장 도톤보리' },
      { img: '/images/city/district-chuo.jpg', caption: '도요토미 히데요시가 세운 오사카성과 사통팔달의 수로가 만든 ‘천하의 부엌’' },
      { img: '/images/places/kuromon-market.jpg', caption: '체면보다 재료 본연의 신선함과 실속을 최우선으로 여기는 오사카 상인들의 시장 문화' },
      { img: '/images/places/harijyu.jpg', caption: '큰 거래를 성사시키고 하루의 노고를 위로하던 오사카 상인들의 최고급 전골 요리' }
    ]
  },
  'chapter-1': {
    shortTab: '1장 · 에도 시대 상인',
    heroImg: '/images/places/dotonbori-imai.jpg',
    subheadings: [
      '도쿄의 진간장 국물 vs 오사카의 맑은 홋카이도 다시마 국물',
      '1893년 키츠네 우동의 탄생과 180년 씨육수 관서풍 오뎅',
      '바쁜 상인의 지혜: 네모난 판초밥(하코즈시·바테라)과 숯불 마무시 장어',
      '다도 성인 센노 리큐의 차(茶)와 340년 양갱·부부 단팥죽·명주'
    ],
    paraPhotos: [
      { img: '/images/places/oguraya-yamamoto.jpg', caption: '북방 무역선(키타마에부네)이 오사카 항구로 실어 나른 최상급 홋카이도 천연 다시마' },
      { img: '/images/places/matsubaya.jpg', caption: '달콤한 유부를 우동 위에 얹어 먹기 시작한 세계 최초의 키츠네 우동과 황금빛 다시 국물' },
      { img: '/images/places/sushiman.jpg', caption: '나무틀에 도미·새우·붕장어·고등어를 눌러 담아 모자이크 보석처럼 썰어낸 오사카 판초밥(하코즈시)' },
      { img: '/images/places/tsuboichi-tea.jpg', caption: '오사카 사카이 상인 출신 다성(茶聖) 센노 리큐의 정신을 잇는 다도와 전통 화과자·양갱' }
    ]
  },
  'chapter-2': {
    shortTab: '2장 · 1920년대 경양식',
    heroImg: '/images/places/hokkyokusei.jpg',
    subheadings: [
      '도쿄를 제치고 일본 인구·경제 1위에 오른 ‘대오사카 시대’',
      '서양 요리에 오사카의 정을 입힌 ‘요쇼쿠(일본식 경양식)’',
      '1922년 위장 약한 단골을 위한 배려, 세계 최초 오므라이스의 탄생',
      '날계란 비빔 카레·암소 와규 스키야키·호일 함박·클래식 킷사텐'
    ],
    paraPhotos: [
      { img: '/images/places/nakanoshima-culture.jpg', caption: '1920년대 도쿄를 추월해 세계 6대 대도시로 도약했던 ‘대오사카(大大阪) 시대’의 나카노시마 중앙공회당' },
      { img: '/images/places/touyou-tei.jpg', caption: '서양의 스테이크와 스튜를 일본인의 입맛에 맞게 재해석한 은박지 호일 함박스테이크' },
      { img: '/images/places/hokkyokusei.jpg', caption: '위장이 약해 밥과 계란만 먹던 단골손님을 위해 1922년 탄생한 세계 최초의 오므라이스' },
      { img: '/images/places/jiyuken.jpg', caption: '식지 않도록 밥에 카레를 미리 비벼 내고 날계란을 얹어준 1910년 창업 원조 명물 카레' }
    ]
  },
  'chapter-3': {
    shortTab: '3장 · 전후 서민 소울푸드',
    heroImg: '/images/places/chitose.jpg',
    subheadings: [
      '잿더미 속에서 다시 피어난 만자이(만담) 극장가의 웃음과 연기',
      '“아지매, 우동 면 빼고 고기 국물만 주이소!” — 해장국 니쿠스이',
      '모던야키와 마요네즈 혁명, 소 곱창 튀김 카스 우동, 쿠시카츠와 551 만두',
      '참복 요리의 대중화와 도톤보리 움직이는 대게 간판의 쇼맨십'
    ],
    paraPhotos: [
      { img: '/images/city/district-tennoji.jpg', caption: '전후 폐허 속에서 서민들의 유머와 활력으로 다시 일어난 난바·신세카이 골목' },
      { img: '/images/places/chitose.jpg', caption: '숙취에 시달리던 만담 개그맨의 한마디로 탄생해 오사카의 영혼이 된 고기국물 ‘니쿠스이’' },
      { img: '/images/places/botejyu-honten.jpg', caption: '배고픈 종업원 식사에서 탄생한 ‘모던야키(야키소바 넣은 오코노미야키)’와 화이트 마요네즈의 혁명' },
      { img: '/images/places/kani-doraku.jpg', caption: '오사카 특유의 유쾌한 쇼맨십과 미식 문화를 상징하는 도톤보리의 움직이는 대게 간판과 복어 요리' }
    ]
  },
  'chapter-4': {
    shortTab: '4장 · 현대 미식 & 야식학',
    heroImg: '/images/places/gyukatsu-motomura.jpg',
    subheadings: [
      '1958년 맥주 공장 컨베이어 벨트에서 발명된 ‘세계 최초 회전초밥’',
      '미니 화로 규카츠, 프렌치 셰프의 배추 라멘, 2m 거대 주걱 화로구이',
      '편의점 컵라면 ‘닛신 돈베이’ 옆면의 비밀: 서일본(W) vs 동일본(E)',
      '12월 겨울 한정 맥도날드 ‘그라코로’와 천공 정원 온천 후 병우유 한 잔'
    ],
    paraPhotos: [
      { img: '/images/places/hakodate-kantaro.jpg', caption: '1958년 아사히 맥주 공장의 컨베이어 벨트에서 영감을 얻어 오사카에서 세계 최초로 발명된 회전초밥' },
      { img: '/images/places/kamukura-ramen.jpg', caption: '프렌치 콘소메 기법으로 배추의 달큰한 감칠맛을 뽑아낸 오사카 소울 라멘과 1인 미니화로 규카츠' },
      { img: '/images/places/rikuro-ojisan.jpg', caption: '종소리와 함께 갓 구워져 나오는 구름 치즈케이크와 간사이 한정 먹거리' },
      { img: '/images/places/soraniwa-onsen.jpg', caption: '16세기 오사카 거리를 재현한 천공 정원 온천과 목욕 후 마시는 차가운 유리병 우유의 로망' }
    ]
  },
  'chapter-5': {
    shortTab: '5장 · 숨은 골목 & 축제',
    heroImg: '/images/places/minoh-waterfall.jpg',
    subheadings: [
      '화려한 네온사인 뒤편에 숨은 오사카의 고즈넉한 시간과 자연',
      '1,300년 전 수련승의 간식 ‘단풍잎 튀김’을 파는 미노오 폭포 산책길',
      '전쟁의 화마를 기적처럼 피한 1920년대 목조 골목, 나카자키초',
      '고려청자 미술관 나카노시마와 1,800년 역사의 스미요시 신년 축제'
    ],
    paraPhotos: [
      { img: '/images/places/karahori-len.jpg', caption: '오사카 원래의 언덕 지형과 100년 전 목조 가옥이 그대로 살아 숨 쉬는 골목 풍경' },
      { img: '/images/places/minoh-waterfall.jpg', caption: '1년간 소금에 절인 진짜 단풍잎을 달콤한 반죽에 튀겨 파는 세계 유일의 미노오 폭포 계곡길' },
      { img: '/images/places/nakazakicho.jpg', caption: '제2차 세계대전 공습에서 기적적으로 살아남아 공방과 레트로 카페가 된 1920년대 목조 마을 나카자키초' },
      { img: '/images/places/sumiyoshi-taisha-hatsumode.jpg', caption: '연말연시 230만 명이 찾아 새해 소원을 빌고 수백 개 포장마차가 열리는 1,800년 고찰 스미요시 타이샤' }
    ]
  },
  'chapter-6': {
    shortTab: '6장 · 장인 명품 & 로컬 브랜드',
    heroImg: '/images/places/sakai-knives.jpg',
    subheadings: [
      '전국시대 조총과 일본도를 벼리던 대장장이 도시, 사카이(堺)의 주방칼',
      '뚜껑이 스스로 닫히는 나니와 주석 차통·술잔·덴마 키리코·센슈 타올',
      'Made in Osaka 로컬 가방(마스터피스)·수제 가죽지갑(무네카와)·140년 문구',
      '“집안을 일으킨다(興す)” 220년 전통과자 오코시·G20 와교·백화점 명과'
    ],
    paraPhotos: [
      { img: '/images/places/sakai-knives.jpg', caption: '일본 프로 셰프의 90%가 사용하며 그 자리에서 이름을 새겨주는 600년 전통 사카이 수제 식도' },
      { img: '/images/places/osaka-tea-ware.jpg', caption: '손을 대지 않아도 뚜껑의 무게만으로 스르륵 닫히며 공기를 밀폐하는 국가 지정 전통공예 나니와 주석 차통' },
      { img: '/images/places/masterpiece-osaka.jpg', caption: '오사카 자체 공방 장인들이 만드는 로컬 가방 브랜드 마스터피스와 수제 가죽지갑·140년 만년필 문구' },
      { img: '/images/places/amidaike-daikoku.jpg', caption: '출세와 번창을 기원하며 1805년부터 선물하던 오사카 전통 쌀강정 오코시와 G20 공식 선물 와교' }
    ]
  }
};
---

<div class="stories-view">
  <!-- 상단 인트로 & 뷰 모드 컨트롤 -->
  <section class="stories-intro-bar">
    <div class="intro-left">
      <span class="stamp-badge">大阪物語 · 스토리 매거진</span>
      <div class="intro-texts">
        <h2 class="intro-title">스토리를 먼저 읽고 찾아가는 오사카 400년 미식·장인 이야기</h2>
        <p class="intro-desc">
          가게 이름만 외워서 가는 여행 대신, 그 음식과 물건이 왜 오사카에서 탄생했는지 이야기와 사진으로 먼저 만나보세요. 이야기 하단의 가게 버튼을 누르면 해당 매장 상세 정보로 바로 연결됩니다.
        </p>
      </div>
    </div>
    <button type="button" id="btn-toggle-all-chapters" class="btn-view-mode" data-mode="single">
      📖 7개 장 전체 한꺼번에 펼치기
    </button>
  </section>

  <!-- 상단 챕터 선택 탭 바 -->
  <nav class="chapter-tabs-nav" aria-label="미식 역사 챕터 선택">
    <div class="chapter-tabs-scroll">
      {stories.map((ch, idx) => {
        const meta = chapterMeta[ch.id];
        return (
          <button
            type="button"
            class={`chapter-tab-btn ${idx === 0 ? 'active' : ''}`}
            data-story-target={ch.id}
            data-story-index={idx}
          >
            <span class="tab-idx">{idx === 0 ? '序' : `${idx}장`}</span>
            <span class="tab-label">{meta ? meta.shortTab.split(' · ')[1] : ch.number}</span>
          </button>
        );
      })}
      <button
        type="button"
        class="chapter-tab-btn"
        data-story-target="special-appendix"
        data-story-index={stories.length}
      >
        <span class="tab-idx">別冊</span>
        <span class="tab-label">4대 알짜 비화</span>
      </button>
    </div>
  </nav>

  <!-- 각 챕터 본문 리더 컨테이너 -->
  <div class="chapters-reader-container" id="chapters-reader-container">
    {stories.map((ch, idx) => {
      const meta = chapterMeta[ch.id];
      const featuredPlaces = ch.featuredPlaceIds
        .map(id => placesMap.get(id))
        .filter(Boolean);
      const prevCh = idx > 0 ? stories[idx - 1] : null;
      const nextCh = idx < stories.length - 1 ? stories[idx + 1] : null;

      return (
        <article
          class={`story-chapter-panel ${idx === 0 ? 'active-chapter' : 'hidden-chapter'}`}
          id={`story-panel-${ch.id}`}
          data-chapter-panel={ch.id}
          data-chapter-idx={idx}
        >
          <!-- 챕터 상단 비주얼 배너 -->
          <div class="ch-hero-banner">
            <img
              src={meta?.heroImg || '/images/city/hero-osaka.jpg'}
              alt={ch.title}
              loading={idx === 0 ? 'eager' : 'lazy'}
              class="ch-hero-img"
            />
            <div class="ch-hero-overlay">
              <div class="ch-badge-row">
                <span class="ch-num-pill">{ch.number}</span>
                <span class="ch-period-pill">{ch.period}</span>
              </div>
              <h3 class="ch-title">{ch.title}</h3>
              <p class="ch-subtitle">{ch.subtitle}</p>
            </div>
          </div>

          <div class="ch-body-inner">
            <!-- 3초 핵심 요약 리드박스 -->
            <div class="ch-lead-box">
              <span class="lead-kicker">💡 이 장의 핵심 이야기</span>
              <p class="ch-lead-text">{ch.lead}</p>
            </div>

            <!-- 단락별 소제목 + 깊이 있는 스토리 + 스토리 전용 사진 화보 결합! -->
            <div class="ch-paragraphs-list">
              {ch.content.map((p, pIdx) => {
                const subhead = meta?.subheadings?.[pIdx];
                const photoObj = meta?.paraPhotos?.[pIdx];
                return (
                  <div class="story-block">
                    <div class="story-text-col">
                      {subhead && (
                        <h4 class="story-subhead">
                          <span class="subhead-num">0{pIdx + 1}</span>
                          <span>{subhead}</span>
                        </h4>
                      )}
                      <p class="story-para">{p}</p>
                    </div>

                    {photoObj && (
                      <figure class="story-figure">
                        <div class="figure-img-wrap">
                          <img src={photoObj.img} alt={photoObj.caption} loading="lazy" class="figure-img" />
                        </div>
                        <figcaption class="figure-caption">📸 {photoObj.caption}</figcaption>
                      </figure>
                    )}
                  </div>
                );
              })}
            </div>

            <!-- 시대 명언 인용구 박스 -->
            {ch.quote && (
              <blockquote class="ch-quote-box">
                <span class="quote-mark">“</span>
                <p class="quote-text">{ch.quote.text}</p>
                <cite class="quote-author">— {ch.quote.author}</cite>
              </blockquote>
            )}

            <!-- 이 이야기에 등장한 가게 바로가기 링크 칩 (무거운 카드 중복을 없애고 원클릭 점프!) -->
            {featuredPlaces.length > 0 && (
              <section class="chapter-jump-places">
                <div class="deck-header">
                  <div class="deck-title-group">
                    <span class="deck-badge">이야기 속 명소 {featuredPlaces.length}곳</span>
                    <h5 class="deck-title">이 이야기의 주인공들을 실제로 만나러 가볼까요?</h5>
                  </div>
                  <span class="deck-hint">누르면 해당 가게 상세 카드로 즉시 이동합니다</span>
                </div>

                <div class="jump-chips-grid">
                  {featuredPlaces.map((place) => {
                    if (!place) return null;
                    return (
                      <button
                        type="button"
                        class="jump-place-card"
                        data-jump-place={place.id}
                      >
                        <div class="jp-thumb">
                          <img src={place.image} alt={place.nameKo} loading="lazy" />
                        </div>
                        <div class="jp-info">
                          <div class="jp-top">
                            <strong class="jp-ko">{place.nameKo}</strong>
                            <span class="jp-area">{place.areaLabel}</span>
                          </div>
                          <span class="jp-ja">{place.nameJa}</span>
                          <span class="jp-menu">{place.signatureMenu}</span>
                        </div>
                        <span class="jp-arrow">상세 →</span>
                      </button>
                    );
                  })}
                </div>
              </section>
            )}

            <!-- 하단 책장 넘기기 (이전 장 / 다음 장 네비게이션) -->
            <footer class="chapter-pager">
