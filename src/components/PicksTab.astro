---
---

<div class="picks-view">
  <!-- 공유 링크 수신 시 알림 배너 (상대방의 찜 목록을 가져왔을 때) -->
  <div id="shared-picks-banner" class="shared-banner" hidden>
    <div class="banner-content">
      <span class="banner-icon">🎁</span>
      <div class="banner-text">
        <strong class="banner-title">친구가 공유한 오사카 찜 목록이 도착했습니다!</strong>
        <p class="banner-desc" id="shared-banner-count-text">총 0곳의 장소가 담겨 있습니다.</p>
      </div>
    </div>
    <div class="banner-actions">
      <button type="button" id="btn-merge-picks" class="banner-btn btn-merge">
        ➕ 내 찜에 합치기
      </button>
      <button type="button" id="btn-replace-picks" class="banner-btn btn-replace">
        🔄 새 목록으로 교체
      </button>
      <button type="button" id="btn-ignore-picks" class="banner-btn btn-ignore">
        👀 구경만 하기
      </button>
    </div>
  </div>

  <!-- 찜 바구니 상단 요약 바 -->
  <header class="picks-top-bar">
    <div class="picks-heading-group">
      <h3 class="picks-main-title">
        내가 찜한 오사카 장소 (<span id="picks-total-num">0</span>)
      </h3>
      <p class="picks-sub">권역별로 자동 분류되어 하루 여행 동선 짜기가 훨씬 수월해집니다.</p>
    </div>

    <div class="picks-global-actions">
      <button type="button" id="btn-share-picks-link" class="action-share-link">
        <span class="icon">🔗</span>
        <span>카톡·친구 공유 링크 복사</span>
      </button>

      <button type="button" id="btn-clear-all-picks" class="action-clear-all" title="전체 삭제">
        비우기
      </button>
    </div>
  </header>

  <!-- 찜한 장소가 없을 때 (Empty State) -->
  <div id="picks-empty-state" class="picks-empty-state">
    <span class="empty-icon">🏮</span>
    <h4 class="empty-title">아직 찜한 장소가 없습니다.</h4>
    <p class="empty-desc">
      [맛집·명소 찾기]나 [미식·역사 이야기]에서 마음에 드는 가게 카드의 하트(♥)를 눌러보세요!
    </p>
    <button type="button" id="btn-go-explore" class="btn-primary-action">
      🔍 맛집·명소 둘러보러 가기
    </button>
  </div>

  <!-- 권역별 그룹핑 렌더링 컨테이너 -->
  <div id="picks-grouped-container" class="picks-grouped-container">
    <!-- 1. 난바·도톤보리 권역 그룹 -->
    <section class="picks-area-section" id="area-group-namba" hidden>
      <div class="area-group-header">
        <span class="area-dot red"></span>
        <h4 class="area-group-title">난바 · 도톤보리 권역</h4>
        <span class="area-count" id="count-namba">0</span>
      </div>
      <div class="area-cards-grid" id="grid-namba"></div>
    </section>

    <!-- 2. 신사이바시 권역 그룹 -->
    <section class="picks-area-section" id="area-group-shinsaibashi" hidden>
      <div class="area-group-header">
        <span class="area-dot orange"></span>
        <h4 class="area-group-title">신사이바시 권역</h4>
        <span class="area-count" id="count-shinsaibashi">0</span>
      </div>
      <div class="area-cards-grid" id="grid-shinsaibashi"></div>
    </section>

    <!-- 3. 우메다 권역 그룹 -->
    <section class="picks-area-section" id="area-group-umeda" hidden>
      <div class="area-group-header">
        <span class="area-dot blue"></span>
        <h4 class="area-group-title">우메다 (키타) 권역</h4>
        <span class="area-count" id="count-umeda">0</span>
      </div>
      <div class="area-cards-grid" id="grid-umeda"></div>
    </section>

    <!-- 4. 기타 권역 그룹 -->
    <section class="picks-area-section" id="area-group-other" hidden>
      <div class="area-group-header">
        <span class="area-dot gray"></span>
        <h4 class="area-group-title">기타 (중앙구·혼마치·센슈·외곽) 권역</h4>
        <span class="area-count" id="count-other">0</span>
      </div>
      <div class="area-cards-grid" id="grid-other"></div>
    </section>
  </div>
</div>

<style>
  .picks-view {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: 50px;
  }

  /* 공유 링크 수신 알림 배너 */
  .shared-banner {
    background: #FFFBEB;
    border: 1.5px solid #F59E0B;
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.15);
  }

  .shared-banner[hidden] {
    display: none !important;
  }

  .banner-content {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .banner-icon {
    font-size: 1.8rem;
    line-height: 1;
  }

  .banner-title {
    font-size: 1rem;
    color: #78350F;
  }

  .banner-desc {
    font-size: 0.82rem;
    color: #92400E;
    margin-top: 2px;
  }

  .banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .banner-btn {
    padding: 8px 14px;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    transition: all 0.15s ease;
  }

  .btn-merge {
    background: var(--color-vermilion);
    color: #FFFFFF;
  }

  .btn-replace {
    background: #1E293B;
    color: #FFFFFF;
  }

  .btn-ignore {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    color: #475569;
  }

  /* 상단 액션 바 */
  .picks-top-bar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-bottom: 2px solid #E2E8F0;
    padding-bottom: 16px;
  }

  @media (min-width: 768px) {
    .picks-top-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .picks-main-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 800;
    color: #0F172A;
  }

  .picks-sub {
    font-size: 0.84rem;
    color: #64748B;
  }

  .picks-global-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .action-share-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-vermilion);
    color: #FFFFFF;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 0.84rem;
    font-weight: 700;
    box-shadow: 0 2px 6px rgba(214, 59, 34, 0.25);
    transition: all 0.15s ease;
  }

  .action-share-link:hover {
    background: #B52812;
  }

  .action-clear-all {
    padding: 8px 12px;
    background: #F1F5F9;
    color: #64748B;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .action-clear-all:hover {
    color: #EF4444;
    border-color: #FCA5A5;
  }

  /* 빈 상태 */
  .picks-empty-state {
    background: #FFFFFF;
    border: 1px dashed #CBD5E1;
    border-radius: 16px;
    padding: 48px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .empty-icon {
    font-size: 3rem;
  }

  .empty-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 800;
    color: #0F172A;
  }

  .empty-desc {
    font-size: 0.88rem;
    color: #64748B;
    max-width: 380px;
    line-height: 1.55;
  }

  .btn-primary-action {
    margin-top: 8px;
    background: #1E293B;
    color: #FFFFFF;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 700;
  }

  /* 권역별 섹션 */
  .picks-grouped-container {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .picks-area-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .area-group-header {
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 2px solid #CBD5E1;
    padding-bottom: 8px;
  }

  .area-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .area-dot.red { background: #D63B22; }
  .area-dot.orange { background: #F97316; }
  .area-dot.blue { background: #2563EB; }
  .area-dot.gray { background: #64748B; }

  .area-group-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 800;
    color: #0F172A;
  }

  .area-count {
    background: #E2E8F0;
    color: #334155;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 10px;
  }

  .area-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .area-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .area-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script is:inline>
  (function() {
    const STORAGE_KEY = 'osaka_my_picks';
    let myPicks = [];
    let pendingSharedPicks = [];

    // 로컬 스토리지에서 찜 목록 로드
    function loadPicks() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        myPicks = stored ? JSON.parse(stored) : [];
      } catch(e) {
        myPicks = [];
      }
    }

    function savePicks() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(myPicks));
      } catch(e) {}
      updateCounters();
      renderPicksView();
      syncHeartButtons();
    }

    // 카운터 뱃지 갱신
    function updateCounters() {
      const desktopCounter = document.getElementById('desktop-picks-counter');
      const mobileCounter = document.getElementById('mobile-picks-counter');
      const totalNum = document.getElementById('picks-total-num');

      const count = myPicks.length;
      if (desktopCounter) desktopCounter.textContent = count;
      if (mobileCounter) mobileCounter.textContent = count;
      if (totalNum) totalNum.textContent = count;
    }

    // 모든 카드의 하트 버튼 상태 동기화
    function syncHeartButtons() {
      const buttons = document.querySelectorAll('[data-pick-toggle]');
      buttons.forEach(btn => {
        const placeId = btn.getAttribute('data-pick-toggle');
        const isPicked = myPicks.includes(placeId);
        btn.classList.toggle('picked', isPicked);
        btn.setAttribute('aria-pressed', isPicked ? 'true' : 'false');
      });
    }

    // 찜 바구니 탭 뷰 렌더링 (권역별 자동 그룹핑)
    function renderPicksView() {
      const emptyState = document.getElementById('picks-empty-state');
      const groupedContainer = document.getElementById('picks-grouped-container');
      const placesList = window.__OSAKA_PLACES_DATA__ || [];
      const placesMap = new Map(placesList.map(p => [p.id, p]));

      if (myPicks.length === 0) {
        if (emptyState) emptyState.style.display = 'flex';
        const sections = document.querySelectorAll('.picks-area-section');
        sections.forEach(s => s.setAttribute('hidden', 'true'));
        return;
      }

      if (emptyState) emptyState.style.display = 'none';

      // 4개 권역으로 분류
      const groups = {
        namba: [],
        shinsaibashi: [],
        umeda: [],
        other: []
      };

      myPicks.forEach(id => {
        const place = placesMap.get(id);
        if (place) {
          const areaKey = groups[place.area] ? place.area : 'other';
          groups[areaKey].push(place);
        }
      });

      // 각 권역별 렌더링
      Object.keys(groups).forEach(area => {
        const sec = document.getElementById(`area-group-${area}`);
        const grid = document.getElementById(`grid-${area}`);
        const countEl = document.getElementById(`count-${area}`);
        const items = groups[area];

        if (!sec || !grid) return;

        if (items.length > 0) {
          sec.removeAttribute('hidden');
          if (countEl) countEl.textContent = items.length;
          grid.innerHTML = '';
          items.forEach(place => {
            // 원본 카드를 복제하거나 생성
            const originalCard = document.getElementById(`card-${place.id}`);
            if (originalCard) {
              const clone = originalCard.cloneNode(true);
              clone.id = `picked-card-${place.id}`;
              grid.appendChild(clone);
            }
          });
        } else {
          sec.setAttribute('hidden', 'true');
          grid.innerHTML = '';
        }
      });

      syncHeartButtons();
    }

    // 하트 토글 클릭 처리
    document.addEventListener('click', (e) => {
      const toggleBtn = e.target.closest('[data-pick-toggle]');
      if (toggleBtn) {
        e.preventDefault();
        const placeId = toggleBtn.getAttribute('data-pick-toggle');
        if (!placeId) return;

        const idx = myPicks.indexOf(placeId);
        if (idx >= 0) {
          myPicks.splice(idx, 1);
        } else {
          myPicks.push(placeId);
        }
        savePicks();
      }
    });

    // 찜 목록 공유 링크 복사 (카톡 연동)
    const sharePicksBtn = document.getElementById('btn-share-picks-link');
    if (sharePicksBtn) {
      sharePicksBtn.addEventListener('click', async () => {
        if (myPicks.length === 0) {
          alert('아직 찜한 장소가 없습니다! 먼저 마음에 드는 장소를 하트로 찜해보세요.');
          return;
        }
        const encodedPicks = myPicks.join(',');
        const shareUrl = new URL(window.location.href);
        shareUrl.searchParams.set('tab', 'picks');
        shareUrl.searchParams.set('picks', encodedPicks);

        const shareData = {
          title: '내가 찜한 오사카 미식·명소 코스',
          text: `오사카 여행에서 가보고 싶은 장소 ${myPicks.length}곳을 정리했습니다! 확인해 보세요:`,
          url: shareUrl.toString()
        };

        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch(e) {}
        } else {
          try {
            await navigator.clipboard.writeText(shareUrl.toString());
            alert('공유 링크가 클립보드에 복사되었습니다! 단톡방이나 메모장에 붙여넣으세요.');
          } catch(e) {
            prompt('공유 링크를 복사하세요:', shareUrl.toString());
          }
        }
      });
    }

    // 전체 삭제 버튼
    const clearAllBtn = document.getElementById('btn-clear-all-picks');
    if (clearAllBtn) {
      clearAllBtn.addEventListener('click', () => {
        if (myPicks.length === 0) return;
        if (confirm('찜한 모든 장소를 삭제하시겠습니까?')) {
          myPicks = [];
          savePicks();
        }
      });
    }

    // 둘러보기 버튼
    const goExploreBtn = document.getElementById('btn-go-explore');
    if (goExploreBtn) {
      goExploreBtn.addEventListener('click', () => {
        if (window.osakaSwitchTab) window.osakaSwitchTab('explore');
      });
    }

    // 공유 링크 URL 파라미터(?picks=id1,id2) 감지 및 충돌 방지 배너 처리
    function checkIncomingSharedPicks() {
      const urlParams = new URLSearchParams(window.location.search);
      const incomingPicks = urlParams.get('picks');
      if (!incomingPicks) return;

      const items = incomingPicks.split(',').filter(Boolean);
      if (items.length === 0) return;

      pendingSharedPicks = items;

      // 만약 내 기존 찜 목록이 비어있다면 바로 수용
      if (myPicks.length === 0) {
        myPicks = [...pendingSharedPicks];
        savePicks();
        return;
      }

      // 내 기존 찜이 이미 있다면 안내 배너 노출
      const banner = document.getElementById('shared-picks-banner');
      const countText = document.getElementById('shared-banner-count-text');
      if (banner) {
        banner.removeAttribute('hidden');
        if (countText) countText.textContent = `친구의 추천 ${pendingSharedPicks.length}곳 / 현재 내 찜 ${myPicks.length}곳`;
      }
    }

    // 배너 3대 액션 바인딩
    const mergeBtn = document.getElementById('btn-merge-picks');
    const replaceBtn = document.getElementById('btn-replace-picks');
    const ignoreBtn = document.getElementById('btn-ignore-picks');
    const banner = document.getElementById('shared-picks-banner');

    if (mergeBtn) {
      mergeBtn.addEventListener('click', () => {
        myPicks = Array.from(new Set([...myPicks, ...pendingSharedPicks]));
        savePicks();
        banner.setAttribute('hidden', 'true');
        alert('친구의 찜 목록이 내 찜에 안전하게 합쳐졌습니다!');
      });
    }

    if (replaceBtn) {
      replaceBtn.addEventListener('click', () => {
        if (confirm('기존 내 찜 목록을 지우고 친구의 찜 목록으로 완전히 교체하시겠습니까?')) {
          myPicks = [...pendingSharedPicks];
          savePicks();
          banner.setAttribute('hidden', 'true');
          alert('친구의 찜 목록으로 교체되었습니다!');
        }
      });
    }

    if (ignoreBtn) {
      ignoreBtn.addEventListener('click', () => {
        banner.setAttribute('hidden', 'true');
      });
    }

    // 탭 변경 이벤트 시 렌더링
    window.addEventListener('osaka_tab_change', (e) => {
      if (e.detail?.tab === 'picks') {
        renderPicksView();
      }
    });

    // 초기화
    document.addEventListener('DOMContentLoaded', () => {
      loadPicks();
      updateCounters();
      syncHeartButtons();
      checkIncomingSharedPicks();
      renderPicksView();
    });
  })();
</script>
