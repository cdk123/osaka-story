---
import { airportRoutes, transitTips, signboards, etiquetteRules } from '../data/survival';
import { dialects } from '../data/dialect';
import { mediaWorks, photoSpots } from '../data/media';
---

<div class="survival-view">
  <!-- 0. 12월·연말연시 여행자를 위한 전용 탭 안내 바로가기 바 (중복 제거) -->
  <section class="newyear-shortcut-bar">
    <div class="nys-left">
      <span class="stamp-badge ny-stamp">🎄 12월·연말연시 안내</span>
      <p class="nys-text">
        <strong>12월 31일~1월 3일 오사카 여행자라면?</strong> 짚 감은 술통(코모다루)·해넘이 소바·스미요시 신년 축제·백화점 휴무 생존법과 일본 맥도날드 ‘그라코로’ 주문 가이드는 전용 탭에서 사진과 함께 보실 수 있습니다.
      </p>
    </div>
    <button type="button" class="btn-nys-go" data-tab="december">
      🎄 12월·연말연시 특집 보러가기 →
    </button>
  </section>

  <!-- 1. 간사이 공항 → 시내 이동 3대장 -->
  <section class="survival-section">
    <div class="sec-title-wrap">
      <span class="stamp-badge">공항 입국</span>
      <h3 class="sec-title">간사이 공항에서 시내 들어가는 3대 방법</h3>
      <p class="sec-sub">숙소 위치와 일행 인원수에 맞춰 가장 편한 이동 수단을 선택하세요.</p>
    </div>

    <div class="airport-grid">
      {airportRoutes.map((route) => (
        <div class="airport-card">
          <header class="air-header">
            <h4 class="air-name">{route.nameKo}</h4>
            <span class="air-dest">목적지: {route.targetDestination}</span>
          </header>
          <div class="air-meta">
            <span class="meta-tag">⏱️ {route.duration}</span>
            <span class="meta-tag">💰 {route.price}</span>
          </div>
          <ul class="air-features">
            {route.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
          <div class="air-recommend">
            <strong class="rec-label">추천:</strong>
            <span class="rec-text">{route.recommendFor}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="seigaiha-divider"></div>

  <!-- 2. 대중교통 탑승 꿀팁 & 택시 4인 제한 경고 -->
  <section class="survival-section">
    <div class="sec-title-wrap">
      <span class="stamp-badge">교통 백과</span>
      <h3 class="sec-title">지하철 · 버스 · 택시 이용 꿀팁</h3>
      <p class="sec-sub">신용카드 컨택리스 탑승부터 일본 택시 자동문과 승차 정원 규칙까지</p>
    </div>

    <div class="transit-grid">
      {transitTips.map((cat) => (
        <div class="transit-card">
          <h4 class="trans-cat-title">{cat.titleKo}</h4>
          <div class="trans-tips-list">
            {cat.tips.map((t) => (
              <div class={`trans-tip-item ${t.warning ? 'warning-item' : ''}`}>
                <strong class="tip-t">{t.title}</strong>
                <p class="tip-d">{t.desc}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="seigaiha-divider"></div>

  <!-- 3. 길거리 표지판 & 노렌 해독법 -->
  <section class="survival-section">
    <div class="sec-title-wrap">
      <span class="stamp-badge">간판 해독</span>
      <h3 class="sec-title">거리 표지판 & 식당 앞 노렌(暖簾) 해독법</h3>
      <p class="sec-sub">가게 앞 천 커튼이 걸려 있으면 영업 중! 헷갈리는 한자 간판을 한눈에 정리했습니다.</p>
    </div>

    <div class="signboards-grid">
      {signboards.map((s) => (
        <div class={`sign-card sign-${s.colorType}`}>
          <div class="sign-top">
            <span class="sign-kanji">{s.kanji}</span>
            <span class="sign-kana">{s.kana}</span>
          </div>
          <div class="sign-meaning">
            <strong class="meaning-text">{s.meaningKo}</strong>
            <span class="pronounce-text">[{s.pronounceKo}]</span>
          </div>
          <p class="sign-usage">{s.usageContext}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="seigaiha-divider"></div>

  <!-- 4. 식당 & 거리 예절 6계명 -->
  <section class="survival-section">
    <div class="sec-title-wrap">
      <span class="stamp-badge">현지 문화</span>
      <h3 class="sec-title">오사카 식당 & 거리 예절 6계명</h3>
      <p class="sec-sub">도쿄와 달리 에스컬레이터는 ‘오른쪽 서기’! 현지인들에게 환영받는 여행자 매너</p>
    </div>

    <div class="etiquette-grid">
      {etiquetteRules.map((rule) => (
        <div class="etiquette-card">
          <div class="eti-num-col">
            <span class="eti-icon">{rule.icon}</span>
            <span class="eti-num">0{rule.num}</span>
          </div>
          <div class="eti-body">
            <h4 class="eti-title">{rule.titleKo}</h4>
            {rule.ruleJa && <span class="eti-ja">{rule.ruleJa}</span>}
            <p class="eti-summary">{rule.summary}</p>
            <p class="eti-detail">{rule.detailedGuide}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="seigaiha-divider"></div>

  <!-- 5. 실전 오사카 사투리 10선 플립 카드 + Web Speech API 발음 듣기 -->
  <section class="survival-section" id="dialect-section">
    <div class="sec-title-wrap">
      <span class="stamp-badge">오사카벤</span>
      <h3 class="sec-title">실전 오사카 사투리 10선 & 원어민 발음 듣기</h3>
      <p class="sec-sub">
        ‘오오키니~’ 한마디에 식당 주인의 얼굴에 환한 미소가 번집니다. [🔊 발음 듣기]를 눌러 억양을 들어보세요!
      </p>
    </div>

    <div class="dialects-grid">
      {dialects.map((d) => (
        <div class="dialect-card" data-speech-text={d.phraseJa}>
          <div class="dia-header">
            <span class="dia-tag">{d.tag}</span>
            <button
              type="button"
              class="btn-speak-dialect"
              data-speak={d.phraseJa}
              aria-label={`${d.phraseJa} 일본어 발음 듣기`}
            >
              🔊 발음 듣기
            </button>
          </div>

          <div class="dia-phrase-group">
            <span class="dia-ja">{d.phraseJa}</span>
            <span class="dia-pronounce">{d.pronounceKo}</span>
          </div>

          <div class="dia-meaning-box">
            <strong class="dia-meaning">{d.meaningKo}</strong>
          </div>

          <p class="dia-origin">{d.originKo}</p>

          <div class="dia-example-box">
            <span class="ex-label">실전 사용</span>
            <p class="ex-ja">{d.exampleJa}</p>
            <p class="ex-ko">{d.exampleKo}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="seigaiha-divider"></div>

  <!-- 6. 오사카 배경 영화·애니·소설 4선 -->
  <section class="survival-section">
    <div class="sec-title-wrap">
      <span class="stamp-badge">명작의 무대</span>
      <h3 class="sec-title">오사카가 배경인 영화 · 애니메이션 · 소설 4선</h3>
      <p class="sec-sub">호젠지 요코초의 단팥죽 소설부터 코난의 오사카 사건부까지</p>
    </div>

    <div class="media-grid">
      {mediaWorks.map((work) => (
        <div class="media-card">
          <div class="media-thumb-wrap">
            <img src={work.image} alt={work.titleKo} loading="lazy" class="media-thumb-img" />
            <span class="media-cat-badge">{work.category}</span>
          </div>
          <div class="media-body-inner">
            <header class="media-header">
              <h4 class="media-title">{work.titleKo}</h4>
              <span class="media-orig">{work.titleJa} ({work.releaseYear})</span>
            </header>
            <div class="media-author">
              <span class="author-label">창작자:</span> {work.authorOrDirector}
            </div>
            <div class="media-loc">
              <span class="loc-pin">📍</span> {work.locationKo}
            </div>
            <p class="media-desc">{work.description}</p>
            <blockquote class="media-quote">
              <p>{work.quoteOrScene}</p>
            </blockquote>
            {work.placeId && (
              <button type="button" class="btn-survival-place-jump" data-jump-place={work.placeId}>
                🏪 {work.placeLabel || '배경 명소·가게 상세 보기 →'}
              </button>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="seigaiha-divider"></div>

  <!-- 7. 인생샷 포토 스팟 5선 -->
  <section class="survival-section">
    <div class="sec-title-wrap">
      <span class="stamp-badge">인생 사진</span>
      <h3 class="sec-title">흔하지 않은 오사카 인생샷 포토존 5선</h3>
      <p class="sec-sub">관광객 인파 없이 일행과 고즈넉한 추억을 남기는 감성 촬영지</p>
    </div>

    <div class="photospot-grid">
      {photoSpots.map((spot, idx) => (
        <div class="photo-card">
          <div class="photo-thumb-wrap">
            <img src={spot.image} alt={spot.titleKo} loading="lazy" class="photo-thumb-img" />
            <div class="photo-num-badge">SPOT 0{idx + 1}</div>
          </div>
          <div class="photo-body-inner">
            <h4 class="photo-title">{spot.titleKo}</h4>
            <div class="photo-meta">
              <span>📍 {spot.locationKo}</span>
              <span>⏰ 추천 시간: {spot.bestTime}</span>
            </div>
            <p class="photo-scene">{spot.sceneDesc}</p>
            <div class="photo-tip-box">
              <strong class="ptip-label">📸 촬영 팁:</strong>
              <span class="ptip-text">{spot.tip}</span>
            </div>
            {spot.placeId && (
              <button type="button" class="btn-survival-place-jump" data-jump-place={spot.placeId}>
                📍 {spot.placeLabel || '이 명소 상세 카드 보기 →'}
              </button>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</div>

<style>
  .survival-view {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 50px;
  }

  /* 12월·연말연시 전용 탭 바로가기 바 */
  .newyear-shortcut-bar {
    background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
    color: #FFFFFF;
    border: 1.5px solid #D63B22;
    border-radius: 14px;
    padding: 16px 20px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.12);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (min-width: 768px) {
    .newyear-shortcut-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .nys-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .ny-stamp {
    background: #D63B22;
    color: #FFFFFF;
    border-color: #FFFFFF;
  }

  .nys-text {
    font-size: 0.86rem;
    color: #E2E8F0;
    line-height: 1.55;
  }

  .btn-nys-go {
    align-self: flex-start;
    flex-shrink: 0;
    background: #D63B22;
    color: #FFFFFF;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 9px 16px;
    border-radius: 8px;
    white-space: nowrap;
    transition: background 0.15s ease;
  }

  @media (min-width: 768px) {
    .btn-nys-go {
      align-self: center;
    }
  }

  .btn-nys-go:hover {
    background: #B52812;
  }

  .btn-survival-place-jump {
    margin-top: auto;
    align-self: flex-start;
    background: #FFF5F5;
    border: 1px solid #FECACA;
    color: #B52812;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 7px 12px;
    border-radius: 8px;
    transition: all 0.15s ease;
  }

  .btn-survival-place-jump:hover {
    background: var(--color-vermilion);
    border-color: var(--color-vermilion);
    color: #FFFFFF;
  }

  .survival-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sec-title-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .sec-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 800;
    color: #0F172A;
  }

  .sec-sub {
    font-size: 0.86rem;
    color: #64748B;
  }

  @media (min-width: 768px) {
    .sec-title {
      font-size: 1.65rem;
    }
    .sec-sub {
      font-size: 0.95rem;
    }
  }

  /* 공항 3대장 (태블릿 2단 + 3번째 풀와이드 -> 데스크톱 3단) */
  .airport-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--card-gap);
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .airport-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .airport-grid > .airport-card:nth-child(3):last-child {
      grid-column: 1 / -1;
    }
    .transit-grid > .transit-card:nth-child(3):last-child {
      grid-column: 1 / -1;
    }
    .photospot-grid > .photo-card:nth-child(5):last-child {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .airport-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .airport-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  }

  .air-header {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .air-name {
    font-size: 1.1rem;
    font-weight: 800;
    color: #0F172A;
  }

  .air-dest {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-vermilion-text);
  }

  .air-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.78rem;
    color: #475569;
    background: #F8FAFC;
    padding: 8px 10px;
    border-radius: 6px;
  }

  .air-features {
    list-style: square inside;
    font-size: 0.82rem;
    color: #334155;
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .air-recommend {
    background: #FFFBEB;
    border-left: 3px solid #F59E0B;
    padding: 6px 10px;
    font-size: 0.8rem;
    color: #78350F;
    margin-top: auto;
  }

  /* 대중교통 그리드 (태블릿 2단 -> 데스크톱 3단) */
  .transit-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--card-gap);
  }

  @media (min-width: 640px) {
    .transit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .transit-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .transit-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .trans-cat-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 800;
    color: #0F172A;
    border-bottom: 2px solid #F1F5F9;
    padding-bottom: 8px;
  }

  .trans-tips-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .trans-tip-item {
    background: #F8FAFC;
    border-radius: 8px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .trans-tip-item.warning-item {
    background: #FEF2F2;
    border: 1px solid #FECACA;
  }

  .tip-t {
    font-size: 0.85rem;
    color: #0F172A;
  }

  .warning-item .tip-t {
    color: #991B1B;
  }

  .tip-d {
    font-size: 0.8rem;
    color: #475569;
    line-height: 1.5;
  }

  /* 표지판 그리드 */
  .signboards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  @media (min-width: 640px) {
    .signboards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .signboards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .sign-card {
    background: #FFFFFF;
    border: 1.5px solid #CBD5E1;
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sign-blue { border-color: #93C5FD; background: #F8FAFC; }
  .sign-green { border-color: #86EFAC; background: #F0FDF4; }
  .sign-yellow { border-color: #FDE047; background: #FEFCE8; }
  .sign-red { border-color: #FCA5A5; background: #FEF2F2; }

  .sign-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .sign-kanji {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 900;
    color: #000000;
  }

  .sign-kana {
    font-size: 0.78rem;
    color: #64748B;
  }

  .sign-meaning {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .meaning-text {
    font-size: 0.95rem;
    font-weight: 800;
    color: #1E293B;
  }

  .pronounce-text {
    font-size: 0.8rem;
    color: #2563EB;
  }

  .sign-usage {
    font-size: 0.8rem;
    color: #475569;
    line-height: 1.45;
  }

  /* 식당 예절 그리드 */
  .etiquette-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  @media (min-width: 768px) {
    .etiquette-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .etiquette-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    gap: 14px;
  }

  .eti-num-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .eti-icon {
    font-size: 1.6rem;
    line-height: 1;
  }

  .eti-num {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--color-vermilion-text);
  }

  .eti-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .eti-title {
    font-size: 0.98rem;
    font-weight: 800;
    color: #0F172A;
  }

  .eti-ja {
    font-size: 0.78rem;
    color: #64748B;
  }

  .eti-summary {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-vermilion-text);
  }

  .eti-detail {
    font-size: 0.8rem;
    color: #475569;
    line-height: 1.55;
  }

  /* 사투리 10선 그리드 */
  .dialects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .dialects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .dialect-card {
    background: #FFFFFF;
    border: 1.5px solid #CBD5E1;
    border-radius: 12px;
    padding: 18px 16px;
