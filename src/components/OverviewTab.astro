---
import { busanComparison, districts, markets, specialties } from '../data/city';
---

<div class="overview-view">
  <!-- 히어로 배너: 오사카 도시 비주얼 & 부산 비교 인포그래픽 -->
  <section class="city-hero-card">
    <div class="hero-visual-banner">
      <img
        src={busanComparison.heroImage}
        alt="물의 도시 오사카 도톤보리 야경"
        class="hero-banner-img"
      />
      <div class="hero-banner-overlay">
        <span class="stamp-badge hero-stamp">浪華百科 · 오사카 도시 백과</span>
        <h2 class="hero-title">부산보다 1/3로 압축된 ‘천하의 부엌’</h2>
        <p class="hero-lead">
          산이 많은 부산과 달리 평지에 촘촘히 모여 있어, 지하철 10~20분이면 오사카의 핵심 맛집과 천년 골목 어디든 닿습니다.
        </p>
      </div>
    </div>

    <!-- 부산 비교 3대 지표 카드 -->
    <div class="stats-grid">
      {busanComparison.stats.map((stat) => (
        <div class="stat-card">
          <span class="stat-label">{stat.label}</span>
          <div class="stat-main">{stat.osakaCity}</div>
          <div class="stat-compare">{stat.busanCompare}</div>
          <p class="stat-note">{stat.note}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 6대 구역 인터랙티브 가이드 (실사 사진 + 구역별 맛집 바로가기 연동) -->
  <section class="districts-section">
    <div class="section-title-wrap">
      <span class="section-badge">구역별 완벽 가이드</span>
      <h3 class="section-heading">오사카 핵심 6대 구역 한눈에 읽기</h3>
      <p class="section-sub">북쪽의 백화점·비즈니스 중심지 우메다(키타)부터 남쪽의 미식 불야성 난바·도톤보리(미나미)까지</p>
    </div>

    <div class="districts-grid">
      {districts.map((d) => {
        const googleUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(d.googleQuery)}`;
        return (
          <article class="district-card" id={`district-${d.id}`}>
            <a
              href={googleUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="district-media-link"
              title={`${d.nameKo} 구글 공식 로컬 정보 및 지도 보기`}
            >
              <img src={d.image} alt={d.nameKo} loading="lazy" class="district-img" />
              <span class="district-media-badge" style={`background: ${d.color};`}>
                {d.nameKo.split(' ')[0]}
              </span>
              <span class="district-local-hint">🔍 구글 로컬 정보 ↗</span>
            </a>

            <div class="district-body">
              <div class="d-names">
                <h4 class="d-name-ko">{d.nameKo}</h4>
                <span class="d-name-ja">{d.nameJa}</span>
              </div>
              <p class="d-character">{d.characterKo}</p>
              <p class="d-desc">{d.description}</p>

              <div class="d-highlights-wrap">
                <strong class="d-sub-title">대표 명소 · 골목</strong>
                <ul class="d-pill-list">
                  {d.highlights.map((h) => (
                    <li class="d-pill">{h}</li>
                  ))}
                </ul>
              </div>

              <div class="d-footer-row">
                <div class="d-stations">
                  <span class="station-icon">🚇</span>
                  <span class="stations-text">{d.subwayStations.join(' · ')}</span>
                </div>
                <button
                  type="button"
                  class="btn-district-explore"
                  data-jump-explore-area={d.exploreArea}
                >
                  이 구역 맛집 보기 →
                </button>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <div class="seigaiha-divider"></div>

  <!-- 오사카 3대 전통 시장 (실사 사진 + 구글 로컬 정보 연동) -->
  <section class="markets-section">
    <div class="section-title-wrap">
      <span class="section-badge">식자재의 보물창고</span>
      <h3 class="section-heading">오사카 3대 전통 시장 & 상점가</h3>
      <p class="section-sub">190년 역사의 어시장부터 300년 셰프들의 새벽 도매시장, 2.6km 일본 최장 아케이드까지</p>
    </div>

    <div class="markets-grid">
      {markets.map((m) => {
        const googleUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(m.googleQuery)}`;
        return (
          <article class="market-card">
            <a
              href={googleUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="market-media-link"
              title={`${m.nameKo} 구글 공식 로컬 정보 보기`}
            >
              <img src={m.image} alt={m.nameKo} loading="lazy" class="market-img" />
              <span class="district-local-hint">🏪 구글 공식 로컬 정보 ↗</span>
            </a>
            <div class="market-body">
              <header class="m-card-header">
                <h4 class="m-name">{m.nameKo}</h4>
                <span class="m-name-ja">{m.nameJa}</span>
              </header>
              <div class="m-history">
                <span class="m-hist-badge">역사</span>
                <span>{m.historyKo}</span>
              </div>
              <p class="m-features">{m.featuresKo}</p>
              <div class="m-food-box">
                <strong class="food-label">추천 먹거리:</strong>
                <span class="food-items">{m.signatureFoods.join(', ')}</span>
              </div>
              <div class="m-access">
                <span class="access-icon">🚇</span>
                <span>{m.access}</span>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <div class="seigaiha-divider"></div>

  <!-- 대표 특산물 5선 (실사 사진 도감) -->
  <section class="specialties-section">
    <div class="section-title-wrap">
      <span class="section-badge">나니와 명물 도감</span>
      <h3 class="section-heading">오사카의 풍토가 빚어낸 5대 대표 특산물</h3>
      <p class="section-sub">사과처럼 생으로 베어 무는 물가지부터 오사카만 3대 해산물, 600년 전통의 프로 셰프 칼까지</p>
    </div>

    <div class="specialties-grid">
      {specialties.map((item) => (
        <article class="specialty-card">
          <div class="spec-media">
            <img src={item.image} alt={item.nameKo} loading="lazy" class="spec-img" />
            <span class="spec-cat-floating">{item.category}</span>
          </div>
          <div class="spec-body">
            <div class="spec-head">
              <div class="spec-titles">
                <h4 class="spec-ko">{item.nameKo}</h4>
                <span class="spec-ja">{item.nameJa}</span>
              </div>
            </div>
            <span class="spec-origin">📍 산지: {item.originArea}</span>
            <p class="spec-desc">{item.descriptionKo}</p>
            <div class="spec-tip">
              <strong class="tip-badge">💡 현지 팁</strong>
              <span>{item.tip}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</div>

<script is:inline>
  // 구역 카드에서 [이 구역 맛집 보기] 클릭 시 맛집·명소 찾기 탭으로 이동 후 해당 권역 자동 필터링
  document.addEventListener('click', (e) => {
    const jumpBtn = e.target.closest('[data-jump-explore-area]');
    if (!jumpBtn) return;
    const areaVal = jumpBtn.getAttribute('data-jump-explore-area');
    if (window.osakaSwitchTab) {
      window.osakaSwitchTab('explore');
    }
    setTimeout(() => {
      const areaSelect = document.getElementById('filter-area');
      if (areaSelect && areaVal) {
        areaSelect.value = areaVal;
        areaSelect.dispatchEvent(new Event('change'));
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }, 60);
  });
</script>

<style>
  .overview-view {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-bottom: 40px;
  }

  .city-hero-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
  }

  .hero-visual-banner {
    position: relative;
    width: 100%;
    min-height: 240px;
    max-height: 320px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .hero-banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-banner-overlay {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 28px 20px 22px 20px;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.92) 15%, rgba(15, 23, 42, 0.55) 70%, rgba(15, 23, 42, 0.2) 100%);
    color: #FFFFFF;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .hero-stamp {
    background: rgba(214, 59, 34, 0.9);
    color: #FFFFFF;
    border-color: #FFFFFF;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.3;
  }

  .hero-lead {
    font-size: 0.92rem;
    color: #E2E8F0;
    line-height: 1.6;
    max-width: 720px;
  }

  @media (min-width: 768px) {
    .hero-visual-banner {
      min-height: 280px;
    }
    .hero-banner-overlay {
      padding: 36px 28px 28px 28px;
    }
    .hero-title {
      font-size: 1.9rem;
    }
    .hero-lead {
      font-size: 1.02rem;
    }
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    padding: 20px;
  }

  @media (min-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(3, 1fr);
      padding: 24px;
    }
  }

  .stat-card {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-vermilion-text);
  }

  .stat-main {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0F172A;
  }

  .stat-compare {
    font-size: 0.85rem;
    font-weight: 600;
    color: #2563EB;
  }

  .stat-note {
    font-size: 0.78rem;
    color: #64748B;
    line-height: 1.45;
    margin-top: auto;
  }

  /* 섹션 공통 헤더 */
  .section-title-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    margin-bottom: 16px;
  }

  .section-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-vermilion-text);
    background: rgba(214, 59, 34, 0.08);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .section-heading {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 800;
    color: #0F172A;
  }

  .section-sub {
    font-size: 0.86rem;
    color: #64748B;
  }

  /* 6대 구역 그리드 (모바일 1단 -> 태블릿 2단 -> 데스크톱 3단) */
  .districts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--card-gap);
  }

  @media (min-width: 640px) {
    .districts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .districts-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .district-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 3px 10px rgba(15, 23, 42, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .district-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.1);
  }

  .district-media-link {
    position: relative;
    display: block;
    width: 100%;
    height: 175px;
    background: #E2E8F0;
    overflow: hidden;
  }

  .district-img,
  .market-img,
  .spec-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .district-card:hover .district-img,
  .market-card:hover .market-img,
  .specialty-card:hover .spec-img {
    transform: scale(1.04);
  }

  .district-media-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 6px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .district-local-hint {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(15, 23, 42, 0.82);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 5px;
    backdrop-filter: blur(4px);
  }

  .district-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .d-names {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .d-name-ko {
    font-size: 1.12rem;
    font-weight: 800;
    color: #0F172A;
  }

  .d-name-ja {
    font-family: var(--font-serif);
    font-size: 0.82rem;
    color: #64748B;
  }

  .d-character {
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--color-vermilion-text);
    line-height: 1.45;
  }

  .d-desc {
    font-size: 0.84rem;
    color: #334155;
    line-height: 1.6;
  }

  .d-highlights-wrap {
    background: #F8FAFC;
    padding: 10px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .d-sub-title {
    font-size: 0.72rem;
    color: #64748B;
  }

  .d-pill-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .d-pill {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #334155;
    padding: 2px 6px;
  }

  .d-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid #F1F5F9;
  }

  .d-stations {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.76rem;
    color: #64748B;
  }

  .btn-district-explore {
    font-size: 0.76rem;
    font-weight: 700;
    color: #FFFFFF;
    background: #1E293B;
    padding: 5px 10px;
    border-radius: 6px;
    white-space: nowrap;
    transition: background 0.15s ease;
  }

  .btn-district-explore:hover {
    background: var(--color-vermilion);
  }

  /* 3대 시장 그리드 (태블릿 2단 -> 데스크톱 3단) */
  .markets-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--card-gap);
  }

  @media (min-width: 640px) {
    .markets-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .markets-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .market-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 3px 10px rgba(15, 23, 42, 0.04);
  }

  .market-media-link {
    position: relative;
    display: block;
    width: 100%;
    height: 175px;
    background: #E2E8F0;
    overflow: hidden;
  }

  .market-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .m-card-header {
    display: flex;
    flex-direction: column;
  }

  .m-name {
    font-size: 1.12rem;
    font-weight: 800;
    color: #0F172A;
  }

  .m-name-ja {
    font-family: var(--font-serif);
    font-size: 0.82rem;
    color: #64748B;
  }

  .m-history {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 0.82rem;
    color: #475569;
    line-height: 1.45;
  }

  .m-hist-badge {
    background: #FEF3C7;
    color: #92400E;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .m-features {
    font-size: 0.84rem;
    color: #334155;
    line-height: 1.6;
  }

  .m-food-box {
    background: #FFFBEB;
    border-left: 3px solid #F59E0B;
    padding: 6px 10px;
    font-size: 0.8rem;
    color: #78350F;
  }

  .food-label {
    font-weight: 700;
  }

  .m-access {
    font-size: 0.78rem;
    color: #64748B;
    margin-top: auto;
    display: flex;
    gap: 4px;
  }

  /* 특산물 그리드 (태블릿 세로형 2단 -> 데스크톱 가로형 2단) */
  .specialties-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--card-gap);
  }

  @media (min-width: 640px) {
    .specialties-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .specialty-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 3px 10px rgba(15, 23, 42, 0.04);
  }

  @media (min-width: 1024px) {
    .specialty-card {
      flex-direction: row;
    }
  }

  .spec-media {
    position: relative;
    width: 100%;
    height: 185px;
    background: #E2E8F0;
    flex-shrink: 0;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .spec-media {
      width: 210px;
      height: auto;
      min-height: 100%;
    }
  }

  .spec-cat-floating {
    position: absolute;
    top: 10px;
    left: 10px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #FFFFFF;
    background: rgba(30, 41, 59, 0.88);
    padding: 3px 8px;
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .spec-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .spec-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .spec-ko {
    font-size: 1.08rem;
    font-weight: 800;
    color: #0F172A;
  }

  .spec-ja {
    font-family: var(--font-serif);
    font-size: 0.82rem;
    color: #64748B;
  }

  .spec-origin {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-vermilion-text);
  }

  .spec-desc {
    font-size: 0.84rem;
    color: #334155;
    line-height: 1.6;
  }

  .spec-tip {
    background: #F0FDF4;
    border: 1px solid #BBF7D0;
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 0.78rem;
    color: #166534;
    line-height: 1.45;
    margin-top: auto;
  }

  .tip-badge {
    font-weight: 700;
    display: inline-block;
    margin-right: 4px;
  }
</style>
