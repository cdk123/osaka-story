---
import { busanComparison, districts, markets, specialties } from '../data/city';
---

<div class="overview-view">
  <!-- 히어로 배너: 오사카 도시 비주얼 & 부산 비교 인포그래픽 -->
  <section class="city-hero-card">
    <div class="hero-visual-banner">
      <img
        src={busanComparison.heroImage}
        alt="물의 도시 오사카 도톤보리 야경"
        class="hero-banner-img"
      />
      <div class="hero-banner-overlay">
        <span class="stamp-badge hero-stamp">浪華百科 · 오사카 도시 백과</span>
        <h2 class="hero-title">부산보다 1/3로 압축된 ‘천하의 부엌’</h2>
        <p class="hero-lead">
          산이 많은 부산과 달리 평지에 촘촘히 모여 있어, 지하철 10~20분이면 오사카의 핵심 맛집과 천년 골목 어디든 닿습니다.
        </p>
      </div>
    </div>

    <!-- 부산 비교 3대 지표 카드 -->
    <div class="stats-grid">
      {busanComparison.stats.map((stat) => (
        <div class="stat-card">
          <span class="stat-label">{stat.label}</span>
          <div class="stat-main">{stat.osakaCity}</div>
          <div class="stat-compare">{stat.busanCompare}</div>
          <p class="stat-note">{stat.note}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 첫화면 핵심 포털: 스토리 우선(Story-First) 6대 메인 테마 대시보드 -->
  <section class="home-portal-section">
    <div class="section-title-wrap">
      <span class="section-badge">STORY-FIRST · 스토리부터 읽고 즐기는 오사카</span>
      <h3 class="section-heading">스토리를 먼저 읽고, 그 이야기가 살아 숨 쉬는 곳으로 떠나보세요</h3>
      <p class="section-sub">가게 이름만 외우는 여행이 아니라 음식과 풍습에 담긴 유래·화보를 먼저 읽은 뒤, 원클릭으로 실제 매장이나 명소로 이동합니다.</p>
    </div>

    <div class="portal-cards-grid">
      <button type="button" class="portal-card highlight-story" data-tab="stories">
        <div class="portal-top">
          <span class="portal-icon">📖</span>
          <span class="portal-tag hot">STEP 1 · 프롤로그~8장 + 별책</span>
        </div>
        <h4 class="portal-title">오사카 역사·문화·발명·미식 스토리북</h4>
        <p class="portal-desc">천하의 부엌 400년 미식사부터 글리코상·빌리켄·초록 이끼 불상의 비밀, 인류 최초 인스턴트 라면·자동개찰구 발명, 센노 리큐 다도와 안도 다다오 건축까지</p>
        <span class="portal-cta">이야기 첫 장 펼치기 →</span>
      </button>

      <button type="button" class="portal-card highlight-dec" data-tab="december">
        <div class="portal-top">
          <span class="portal-icon">🎄</span>
          <span class="portal-tag hot">STEP 2 · 12월·연말연시 스토리</span>
        </div>
        <h4 class="portal-title">12월 & 연말연시 풍습 · 마쿠도</h4>
        <p class="portal-desc">짚 감은 술통 ‘코모다루’와 새해 약주 ‘오토소’, 12/31 해넘이 메밀국수 3대 유래, 스미요시 하츠모데, 맥도날드 ‘그라코로’ 한글 발음·음성 주문판</p>
        <span class="portal-cta">12월 연말연시 스토리 읽기 →</span>
      </button>

      <button type="button" class="portal-card" data-tab="explore">
        <div class="portal-top">
          <span class="portal-icon">🍽️</span>
          <span class="portal-tag">엄선 62곳 (중복 0)</span>
        </div>
        <h4 class="portal-title">오사카 맛집 · 다실 · 디저트 도감</h4>
        <p class="portal-desc">스토리 속 원조 노포와 현역 맛집 총집결! 마츠사카규·스키야키, 오므라이스·카레, 판초밥·키츠네·카스 우동, 180년 오뎅·모던야키, 340년 양갱·차</p>
        <span class="portal-cta">5대 미식 도감 열기 →</span>
      </button>

      <button type="button" class="portal-card" data-tab="spots">
        <div class="portal-top">
          <span class="portal-icon">🛍️</span>
          <span class="portal-tag">엄선 27곳 (중복 0)</span>
        </div>
        <h4 class="portal-title">명소 · 문화/발명 · 캐릭터/명품 도감</h4>
        <p class="portal-desc">미노오 폭포·초록 이끼 불상·분라쿠 인형극·츠텐카쿠 빌리켄·컵누들 발명 박물관, 지브리·2,400대 가챠·140년 문구, 오사카 가방·수제 지갑·사카이 식도</p>
        <span class="portal-cta">4대 명소·명품 도감 열기 →</span>
      </button>

      <button type="button" class="portal-card" data-tab="survival">
        <div class="portal-top">
          <span class="portal-icon">🚇</span>
          <span class="portal-tag">초보 필수</span>
        </div>
        <h4 class="portal-title">공항·교통 생존팁 & 오사카 사투리</h4>
        <p class="portal-desc">간사이공항→시내 이동, 지하철 컨택리스·택시 요령, 노렌·한자 간판 해독, 식당 예절 6계명, 원어민 음성 사투리 10선 & 인생샷 포토존</p>
        <span class="portal-cta">생존 가이드 보기 →</span>
      </button>

      <button type="button" class="portal-card" data-tab="picks">
        <div class="portal-top">
          <span class="portal-icon">♥</span>
          <span class="portal-tag">동선 자동정리</span>
        </div>
        <h4 class="portal-title">내 찜 바구니 & 카톡 공유</h4>
        <p class="portal-desc">마음에 드는 가게의 하트(♥)를 누르면 난바·신사이바시·우메다 권역별로 동선이 자동 정리되며 단톡방으로 1초 만에 공유됩니다.</p>
        <span class="portal-cta">내 찜 바구니 열기 →</span>
      </button>
    </div>
  </section>

  <div class="seigaiha-divider"></div>

  <!-- 스토리가 먼저다: 읽고 떠나면 10배 재미있는 오사카 6대 비화 (미식·문화·발명·풍습) -->
  <section class="story-teaser-section">
    <div class="section-title-wrap">
      <span class="section-badge">대표 스토리 미리보기</span>
      <h3 class="section-heading">알고 떠나면 10배 재미있는 오사카 6대 비화 (문화 · 발명 · 풍습 · 미식)</h3>
      <p class="section-sub">거리의 동상과 건축물, 세계 최초의 발명품, 연말 술통과 음식 뒤에 숨은 이야기를 먼저 읽고 현장으로 점프해 보세요.</p>
    </div>

    <div class="teaser-grid">
      <article class="teaser-card">
        <div class="teaser-media">
          <img src="/images/places/hozenji-bunraku.jpg" alt="호젠지 초록 이끼 부동명왕" loading="lazy" class="teaser-img" />
          <span class="teaser-badge">거리 미스터리 & 예술</span>
        </div>
        <div class="teaser-body">
          <h4 class="teaser-title">왜 호젠지 절의 불상은 온몸이 초록 이끼로 덮여 있고, 신세카이 ‘빌리켄’은 발바닥이 닳았을까?</h4>
          <p class="teaser-text">
            1945년 대공습 불바다 속에서 홀로 살아남은 부동명왕에게 한 여인이 국자로 물을 끼얹으며 소원을 빈 것이 80년 초록 이끼 갑옷이 되었고, 1912년 미국에서 건너온 빌리켄은 발바닥을 간지럽히면 복을 준다는 전설로 오사카의 수호신이 되었습니다.
          </p>
          <div class="teaser-actions">
            <button type="button" class="btn-teaser-story" data-jump-story="chapter-7">📖 제7장 거리 전설 읽기</button>
            <button type="button" class="btn-teaser-place" data-jump-place="hozenji-bunraku">⛩️ 호젠지·분라쿠 보기 →</button>
          </div>
        </div>
      </article>

      <article class="teaser-card">
        <div class="teaser-media">
          <img src="/images/places/cupnoodles-museum-ikeda.jpg" alt="컵누들 뮤지엄 오사카 이케다" loading="lazy" class="teaser-img" />
          <span class="teaser-badge">인류를 바꾼 오사카 발명</span>
        </div>
        <div class="teaser-body">
          <h4 class="teaser-title">인류 최초의 ‘인스턴트 라면·컵누들’과 ‘자동개찰구·캡슐호텔’은 왜 오사카에서 발명됐을까?</h4>
          <p class="teaser-text">
            1958년 오사카 이케다시의 뒷마당 오두막에서 안도 모모후쿠가 아내가 튀기던 채소 덴푸라를 보고 발명한 ‘치킨라멘’, 1967년 세계 최초 철도 자동개찰구, 1979년 세계 최초 캡슐호텔까지 실용 발명품의 수도 오사카를 만나보세요.
          </p>
          <div class="teaser-actions">
            <button type="button" class="btn-teaser-story" data-jump-story="chapter-7">📖 제7장 발명 이야기 읽기</button>
            <button type="button" class="btn-teaser-place" data-jump-place="cupnoodles-museum-ikeda">🍜 컵누들 발명관 보기 →</button>
          </div>
        </div>
      </article>

      <article class="teaser-card">
        <div class="teaser-media">
          <img src="/images/places/nakanoshima-culture.jpg" alt="나카노시마 중앙공회당과 다도 문화" loading="lazy" class="teaser-img" />
          <span class="teaser-badge">다도 혁명 & 명건축</span>
        </div>
        <div class="teaser-body">
          <h4 class="teaser-title">도요토미 히데요시의 황금 다실에 맞선 오사카 상인 ‘센노 리큐’와 복서 출신 건축가 ‘안도 다다오’</h4>
          <p class="teaser-text">
            무사도 칼을 풀고 기어들어오게 만든 사카이 상인 센노 리큐의 두 평짜리 다실 혁명, 전 재산 100만 엔을 시민에게 기부해 세운 나카노시마 중앙공회당, 그리고 프로 복서에서 세계 건축 거장이 된 안도 다다오의 발자취입니다.
          </p>
          <div class="teaser-actions">
            <button type="button" class="btn-teaser-story" data-jump-story="chapter-8">📖 제8장 문화·건축 읽기</button>
            <button type="button" class="btn-teaser-place" data-jump-place="nakanoshima-culture">🏛️ 나카노시마 상세 보기 →</button>
          </div>
        </div>
      </article>

      <article class="teaser-card">
        <div class="teaser-media">
          <img src="/images/dec/dec-komodaru.jpg" alt="짚을 감은 연말연시 술통 코모다루" loading="lazy" class="teaser-img" />
          <span class="teaser-badge">연말연시 술통의 유래</span>
        </div>
        <div class="teaser-body">
          <h4 class="teaser-title">신사와 가게 앞에 쌓인 ‘짚 감은 술통(코모다루)’과 막내부터 마시는 새해 술</h4>
          <p class="teaser-text">
            에도 시대 오사카 이타미·나다의 명주를 배에 실어 도쿄로 보낼 때 삼나무 통이 깨지지 않도록 짚(코모)으로 감싼 데서 유래했습니다. 12월 31일 자정엔 나무망치로 술뚜껑을 깨는 ‘카가미비라키’를 열고 새해 아침엔 약초주 ‘오토소’를 나눕니다.
          </p>
          <div class="teaser-actions">
            <button type="button" class="btn-teaser-story" data-tab="december">🎄 12월 연말연시 스토리 읽기</button>
            <button type="button" class="btn-teaser-place" data-jump-place="osaka-sake-jizake">🍶 오사카 명주 도감 보기 →</button>
          </div>
        </div>
      </article>

      <article class="teaser-card">
        <div class="teaser-media">
          <img src="/images/places/sushiman.jpg" alt="오사카 전통 판초밥 하코즈시" loading="lazy" class="teaser-img" />
          <span class="teaser-badge">370년 오사카 초밥의 비밀</span>
        </div>
        <div class="teaser-body">
          <h4 class="teaser-title">도쿄가 주먹초밥(니기리)이라면, 오사카는 왜 네모난 ‘판초밥(하코즈시)’일까?</h4>
          <p class="teaser-text">
            냉장고가 없던 에도 시대, 상인들이 연극을 보거나 귀한 손님에게 선물하기 위해 나무틀(하코)에 초밥과 찐 도미·새우·붕장어를 겹겹이 눌러 담아 보석처럼 썰어낸 예술 초밥입니다.
          </p>
          <div class="teaser-actions">
            <button type="button" class="btn-teaser-story" data-jump-story="chapter-1">📖 제1장 스토리 전문 읽기</button>
            <button type="button" class="btn-teaser-place" data-jump-place="sushiman">🍣 1653년 창업 스시만 보기 →</button>
          </div>
        </div>
      </article>

      <article class="teaser-card">
        <div class="teaser-media">
          <img src="/images/places/hokkyokusei-omurice.jpg" alt="1922년 세계 최초 오므라이스" loading="lazy" class="teaser-img" />
          <span class="teaser-badge">1922년 대오사카의 정(情)</span>
        </div>
        <div class="teaser-body">
          <h4 class="teaser-title">전 세계 오므라이스는 왜 1922년 오사카의 작은 양식당에서 탄생했을까?</h4>
          <p class="teaser-text">
            소화불량으로 매일 오믈렛과 흰 밥만 시키던 단골손님을 안타깝게 여긴 주방장이 케첩 볶음밥을 얇은 달걀지단으로 감싸 내어준 배려가 인류 최초의 ‘오므라이스(Omu + Rice)’가 되었습니다.
          </p>
          <div class="teaser-actions">
            <button type="button" class="btn-teaser-story" data-jump-story="chapter-2">📖 제2장 스토리 전문 읽기</button>
            <button type="button" class="btn-teaser-place" data-jump-place="hokkyokusei">🍳 원조 호쿄쿠세이 보기 →</button>
          </div>
        </div>
      </article>
    </div>
  </section>

  <div class="seigaiha-divider"></div>

  <!-- 6대 구역 인터랙티브 가이드 (실사 사진 + 구역별 맛집 바로가기 연동) -->
  <section class="districts-section">
    <div class="section-title-wrap">
      <span class="section-badge">구역별 완벽 가이드</span>
      <h3 class="section-heading">오사카 핵심 6대 구역 한눈에 읽기</h3>
      <p class="section-sub">북쪽의 백화점·비즈니스 중심지 우메다(키타)부터 남쪽의 미식 불야성 난바·도톤보리(미나미)까지</p>
    </div>

    <div class="districts-grid">
      {districts.map((d) => {
        const googleUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(d.googleQuery)}`;
        return (
          <article class="district-card" id={`district-${d.id}`}>
            <a
              href={googleUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="district-media-link"
              title={`${d.nameKo} 구글 공식 로컬 정보 및 지도 보기`}
            >
              <img src={d.image} alt={d.nameKo} loading="lazy" class="district-img" />
              <span class="district-media-badge" style={`background: ${d.color};`}>
                {d.nameKo.split(' ')[0]}
              </span>
              <span class="district-local-hint">🔍 구글 로컬 정보 ↗</span>
            </a>

            <div class="district-body">
              <div class="d-names">
                <h4 class="d-name-ko">{d.nameKo}</h4>
                <span class="d-name-ja">{d.nameJa}</span>
              </div>
              <p class="d-character">{d.characterKo}</p>
              <p class="d-desc">{d.description}</p>

              <div class="d-highlights-wrap">
                <strong class="d-sub-title">대표 명소 · 골목</strong>
                <ul class="d-pill-list">
                  {d.highlights.map((h) => (
                    <li class="d-pill">{h}</li>
                  ))}
                </ul>
              </div>

              <div class="d-footer-row">
                <div class="d-stations">
                  <span class="station-icon">🚇</span>
                  <span class="stations-text">{d.subwayStations.join(' · ')}</span>
                </div>
                <button
                  type="button"
                  class="btn-district-explore"
                  data-jump-explore-area={d.exploreArea}
                >
                  이 구역 맛집 보기 →
                </button>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <div class="seigaiha-divider"></div>

  <!-- 오사카 3대 전통 시장 (실사 사진 + 구글 로컬 정보 연동) -->
  <section class="markets-section">
    <div class="section-title-wrap">
      <span class="section-badge">식자재의 보물창고</span>
      <h3 class="section-heading">오사카 3대 전통 시장 & 상점가</h3>
