---
import { places } from '../data/places';
import PlaceCard from './PlaceCard.astro';

const areaOptions = [
  { value: 'all', label: '권역 전체' },
  { value: 'namba', label: '난바·도톤보리' },
  { value: 'shinsaibashi', label: '신사이바시' },
  { value: 'umeda', label: '우메다 (키타)' },
  { value: 'other', label: '기타 (오사카성/미노오/베이 등)' }
];

const companionOptions = [
  { value: 'all', label: '동행자 전체' },
  { value: 'family', label: '👨‍👩‍👧‍👦 부모님·5인 대가족(룸/테이블)' },
  { value: 'youth', label: '✨ 1020·동생 취향저격' },
  { value: 'adult', label: '🍶 어른들의 술자리·미식' },
  { value: 'solo', label: '⚡ 혼밥·빠른 한 끼' }
];

// 7대 카테고리 마스터 정의 및 카테고리별 상세 해설
const categorySections = [
  {
    id: 'beef',
    num: '01',
    icon: '🥩',
    titleKo: '와규 · 스키야키 · 고기 요리',
    titleJa: '和牛・すき焼き・肉料理',
    subtitle: '일본 3대 와규 마츠사카규 구이부터 100년 전통 암소 스키야키, 미니화로 규카츠와 해장 고기국물 니쿠스이까지',
    description: '오사카의 고기 문화는 화려함보다 ‘부위별 최상의 감칠맛과 실속’에 집중합니다. 5인 가족이 다다미 룸에서 부위별 명패를 보며 구워 먹는 마츠사카규, 기모노 서버가 처음부터 끝까지 구워주는 1919년 창업 스키야키, 1020 동생들이 열광하는 1인 화로 규카츠, 그리고 개그맨의 숙취 해장국으로 탄생한 오사카 로컬 명물 ‘니쿠스이(고기국물)’를 엄선했습니다.',
    tip: '💡 저녁 메인 와규·스키야키 노포(야키니쿠 M, 하리쥬)는 최소 2주 전 사전 예약을 권장하며, 치토세(니쿠스이)는 낮 14:30에 영업이 끝나므로 반드시 아침·점심 코스로 넣으세요.'
  },
  {
    id: 'curry',
    num: '02',
    icon: '🍛',
    titleKo: '오사카 유래 카레 · 근대 경양식 (요쇼쿠)',
    titleJa: '大阪スパイスカレー・老舗洋食',
    subtitle: '1920년대 ‘대오사카 시대’가 탄생시킨 세계 최초의 오므라이스, 달고 매운 오사카식 카레, 호일 함박스테이크',
    description: '도쿄를 제치고 일본 경제 1위를 기록했던 1920년대 오사카는 서양 요리를 일본식 정(情)으로 재해석한 ‘요쇼쿠(경양식)’의 발상지입니다. 위장 약한 단골을 위해 탄생한 전 세계 오므라이스의 시초(호쿄쿠세이, 1922), 밥에 카레를 미리 비벼 날계란을 얹는 원조 명물 카레(지유켄, 1910), 첫입은 과일처럼 달고 뒷맛은 강렬하게 매운 오사카식 카레(인디안 카레, 1947), 그리고 부풀어 오른 은박지를 찢어 먹는 1897년 전통 함박스테이크(동양정)를 만나보세요.',
    tip: '💡 동양정(토요테이)은 백화점 도착 즉시 매장 앞 기계(AirWAIT)에서 대기 번호표부터 뽑고 쇼핑하시는 것이 시간을 아끼는 최고 비결입니다.'
  },
  {
    id: 'noodle',
    num: '03',
    icon: '🍜',
    titleKo: '키츠네·카스 우동 · 판초밥(하코즈시·바테라) · 마무시 장어 · 복어 · 대게',
    titleJa: 'きつね・かすうどん・箱寿司・バッテラ・まむし鰻・てっちり・蟹',
    subtitle: '1893년 원조 키츠네 우동과 소 곱창 튀김 카스 우동, 370년 전통 판초밥(하코즈시·바테라)과 유부초밥, 숯불 마무시 장어와 참복·대게 코스',
    description: '에도 시대 북방 무역선이 실어 나른 최상급 홋카이도 다시마는 오사카 국물 문화의 심장입니다. 달콤한 유부를 얹은 키츠네 우동(1893년 원조 마츠바야 & 도톤보리 이마이), 바삭하게 튀긴 소 곱창(아부라카스)에서 고소한 육즙이 우러나는 오사카 남부 향토 명물 카스 우동(카스야 & 류노스), 나무틀에 도미·새우·붕장어·고등어를 눌러 담아 보석처럼 썰어낸 오사카 전통 판초밥(1653년 창업 스시만 & 1831년 창업 타코타케 & 원형 유래 요시노 스시), 다시 국물을 머금은 오사카 유부초밥(마메다), 생장어를 숯불에 바삭하게 구워 밥 사이에 묻는 마무시 장어(본가 시바토), 그리고 복어·대게 풀코스입니다.',
    tip: '💡 오사카 판초밥(하코즈시)의 역사적 원형인 〈요시노 스시 본점〉은 현재 휴업 중이므로, 실제 식사나 테이크아웃은 현역 성업 중인 370년 전통 〈스시만(한신·타카시마야)〉 또는 195년 전통 〈타코타케(마츠야마치 본점)〉를 방문하세요!'
  },
  {
    id: 'bento',
    num: '04',
    icon: '🥟',
    titleKo: '오사카 코나몬(모던야키·네기야키) · 180년 오뎅·도테야키 · 만두 · 도시락',
    titleJa: '粉もん・モダン焼き・関東煮おでん・どて焼き・豚まん・名物弁当',
    subtitle: '마요네즈와 야키소바를 넣은 모던야키 원조, 180년 씨육수 관서풍 오뎅과 백된장 도테야키, 파 폭탄 네기야키, 551 부타만과 명물 벤또',
    description: '오사카 서민들의 활력이 응축된 철판·분식·야식 문화입니다. 1946년 세계 최초로 화이트 마요네즈와 야키소바 면을 넣은 모던야키를 탄생시킨 원조(보테쥬 총본점 & 치보), 1844년 창업해 180년간 씨육수를 이어온 일본 최고령 관서풍 다시 오뎅과 백된장 소힘줄 조림 도테야키(타코우메 본점 & 하나쿠지라), 대파 폭탄 네기야키(야마모토)와 산마 100% 오코노미야키(미즈노), 국물 타코야키 아카시야키, 쿠시카츠 다루마, 551 호라이 부타만, 2m 거대 주걱 화로구이와 백화점 데파치카 명품 벤또를 모았습니다.',
    tip: '💡 551 호라이 부타만(만두)은 육가공품 검역 규정상 한국으로 반입할 수 없으므로 반드시 오사카 호텔 야식이나 귀국 전 공항에서 따뜻할 때 다 드시고 오세요!'
  },
  {
    id: 'cafe',
    num: '05',
    icon: '🍵',
    titleKo: '정통 차·다실 · 340년 양갱·화과자 · 레트로 킷사텐 · 베이커리',
    titleJa: '日本茶茶寮・老舗羊羹・和菓子・純喫茶・関西ベーカリー',
    subtitle: '다도 성인 센노 리큐 고향의 1850년 제차 명가, 340년 오사카 양갱 총본산과 황실 양갱, 1883년 부부 단팥죽과 1934년 킷사텐 핫케이크',
    description: '일본 다도(茶道)를 완성한 다성(茶聖) 센노 리큐가 오사카 사카이 상인 출신이었던 만큼, 오사카의 차와 다식(양갱·화과자) 문화는 깊이가 남다릅니다. 1850년 사카이에서 창업한 차 명가(츠보이치 제차 본포)와 작가의 도자기 다완에 차를 우려 마시는 현대 다실(와드 카페), 340년 계보를 잇는 오사카 정통 양갱·모나카 총본산(츠루야 하치만)과 500년 황실 양갱의 제왕(토라야), 1883년 단팥죽(메오토 젠자이), 직화 미타라시단고(키야스), 갓 구운 치즈케이크(리쿠로 오지상), 1934년 클래식 다방(마루후쿠 커피점), 그리고 간사이 명물 크루아상과 밀푀유입니다.',
    tip: '💡 어르신 선물로는 상온 보관이 길고 품격 있는 〈츠루야 하치만〉·〈토라야〉의 한입 양갱 세트와 〈츠보이치〉의 덖은 호지차·우지 말차 찻잎이 단연 최고입니다.'
  },
  {
    id: 'spot',
    num: '06',
    icon: '🍁',
    titleKo: '숨은 로컬 명소 · 단풍 폭포 · 천공 온천 · 명문 가이세키',
    titleJa: 'ローカル名所・箕面大滝・空庭温泉・懐石',
    subtitle: '한국인 인파에 치이지 않는 1,300년 단풍잎 튀김 계곡, 1920년대 목조 골목, 국보급 도자 미술관과 정통 가이세키',
    description: '북적이는 번화가에서 한 걸음만 벗어나면 만날 수 있는 오사카의 깊은 시간과 자연, 그리고 정갈한 미식 공간입니다. 1년간 절인 진짜 단풍잎을 튀겨 파는 세계 유일의 미노오 폭포 산책길, 전쟁 대공습 때 기적적으로 불타지 않고 살아남은 1920년대 목조 주택 골목 나카자키초, 1918년 붉은 벽돌 중앙공회당과 세계 최고 수준의 한국 고려청자·조선백자 컬렉션을 소장한 나카노시마, 100년 언덕길 가라호리 상점가, 유카타를 입고 거니는 소라니와 온천, 그리고 부모님과 조용히 즐기는 두부 가이세키·미슐랭 돈카츠입니다.',
    tip: '💡 오전에는 미노오 폭포나 나카자키초 목조 골목을 산책하고, 해 질 녘 나카노시마 강변이나 소라니와 온천을 방문하면 가장 여유롭고 품격 있는 가족 인생샷 코스가 완성됩니다.'
  },
  {
    id: 'craft',
    num: '07',
    icon: '🔪',
    titleKo: '600년 장인의 명품 · 주석 차통·다기 · 오사카 전통과자(오코시) · 명주',
    titleJa: '大阪伝統工芸・錫茶筒と茶器・大阪銘菓おこし・地酒と麦焼酎',
    subtitle: '사카이 수제 식도, 뚜껑이 스스로 닫히는 주석 차통·수제 찻주전자, 220년 전통 쌀강정 ‘오코시’와 G20 정상 공식 과자 ‘와교’, 로컬 사케·보리소주',
    description: '흔한 드럭스토어 공산품 대신, 여행이 끝난 뒤에도 평생 식탁과 다탁에서 오사카를 떠올리게 해 줄 진짜 명품들입니다. 가족 이름을 새겨주는 600년 사카이 수제 주방칼, 뚜껑을 놓으면 자기 무게로 스르륵 내려와 찻잎을 밀폐하는 나니와 주석 차통(茶筒)과 수제 찻주전자(큐스)·말차 다완, 술맛을 부드럽게 바꾸는 주석 술잔과 덴마 키리코 컷글라스, 1초 흡수 센슈 타올, 그리고 “집안과 사업을 일으킨다(興す)”는 뜻의 1805년 창업 오사카 전통 과자 ‘아미다보리 오코시’와 G20 정상회의 공식 선물 ‘아와겐 와교(和洋)’, 백화점 한정 디저트(바통도르·시오콘부)와 오사카 명주·보리소주입니다.',
    tip: '💡 사카이 수제 주방칼은 기내 휴대 반입이 절대 불가하므로 출국 시 반드시 부치는 짐(위탁수하물 캐리어)에 넣으셔야 합니다!'
  }
];
---

<div class="explore-view">
  <!-- 1. 상단 페이지 안내 및 큐레이션 가이드 배너 -->
  <section class="explore-intro-banner">
    <div class="intro-top-row">
      <span class="stamp-badge">厳選七十四選 · 엄선 {places.length}선</span>
      <span class="intro-sub-pill">광구성 맛집 제외 · 원조 유래 보존 + 현역 성업 명점 완비</span>
    </div>
    <h2 class="explore-page-title">
      오사카에서 유래한 원조 명물부터 100년 노포·장인 명품까지
    </h2>
    <p class="explore-page-desc">
      단순히 유명한 식당을 나열하지 않고, <strong>‘왜 오사카에서 이 음식과 장소를 경험해야 하는가’</strong>를 기준으로 <strong>7대 카테고리 총 {places.length}곳</strong>을 분류했습니다. 아래 카테고리별 해설을 읽으며 우리 가족·일행에게 딱 맞는 코스를 골라보세요.
    </p>

    <div class="explore-usage-guide">
      <div class="usage-item">
        <span class="usage-icon">📸</span>
        <span><strong>사진·상호 클릭:</strong> 구글 공식 로컬 매장정보 & 실제 리뷰 사진 열람</span>
      </div>
      <div class="usage-item">
        <span class="usage-icon">🚕</span>
        <span><strong>기사님·직원 버튼:</strong> 택시 일본어 주소·5인석 문의·손가락 주문판</span>
      </div>
      <div class="usage-item">
        <span class="usage-icon">♥</span>
        <span><strong>하트(찜) 버튼:</strong> 내 찜 바구니에 권역별 동선으로 자동 분류</span>
      </div>
    </div>
  </section>

  <!-- 2. 스마트 필터 & 카테고리 바로가기 바 (Sticky) -->
  <section class="filter-sticky-bar" id="explore-filter-bar">
    <!-- 카테고리 원터치 칩 레일 -->
    <div class="cat-chips-rail" aria-label="카테고리 선택">
      <button type="button" class="cat-quick-chip active" data-cat-chip="all">
        <span>전체 7대 카테고리</span>
        <span class="chip-cnt">{places.length}</span>
      </button>
      {categorySections.map((sec) => {
        const cnt = places.filter(p => p.category === sec.id).length;
        return (
          <button type="button" class="cat-quick-chip" data-cat-chip={sec.id}>
            <span>{sec.icon} {sec.titleKo.split(' · ')[0]}</span>
            <span class="chip-cnt">{cnt}</span>
          </button>
        );
      })}
    </div>

    <!-- 검색창 & 권역/동행자 상세 필터 -->
    <div class="filter-controls-row">
      <div class="search-input-wrap">
        <span class="search-icon">🔍</span>
        <input
          type="search"
          id="explore-search-input"
          placeholder="가게명, 일본어 상호, 대표 메뉴 검색..."
          class="search-input"
          autocomplete="off"
        />
        <button type="button" id="btn-clear-search" class="btn-clear-search" aria-label="검색어 지우기" hidden>
          ✕
        </button>
      </div>

      <div class="filter-selects-wrap">
        <select id="filter-area" class="filter-select" aria-label="권역 선택">
          {areaOptions.map(opt => (
            <option value={opt.value}>{opt.label}</option>
          ))}
        </select>

        <!-- 기존 스크립트 호환용 카테고리 select (칩과 양방향 동기화) -->
        <select id="filter-category" class="filter-select" aria-label="카테고리 선택">
          <option value="all">카테고리 전체 (7종)</option>
          {categorySections.map(sec => (
            <option value={sec.id}>{sec.icon} {sec.titleKo}</option>
          ))}
        </select>

        <select id="filter-companion" class="filter-select" aria-label="동행자 맞춤 선택">
          {companionOptions.map(opt => (
            <option value={opt.value}>{opt.label}</option>
          ))}
        </select>

        <button type="button" id="btn-reset-filters" class="btn-reset-filters" title="필터 초기화">
          🔄 초기화 (<span id="matching-count">{places.length}</span>곳)
        </button>
      </div>
    </div>
  </section>

  <!-- 3. 7대 카테고리별 섹션 & 카테고리 해설 + 장소 카드 그리드 -->
  <div class="category-sections-container" id="explore-places-grid">
    {categorySections.map((sec) => {
      const secPlaces = places.filter(p => p.category === sec.id);
      return (
        <section class="category-section-block" id={`cat-sec-${sec.id}`} data-category-section={sec.id}>
          <!-- 카테고리 설명 헤더 카드 -->
          <header class="cat-section-header">
            <div class="cat-header-top">
              <div class="cat-title-wrap">
