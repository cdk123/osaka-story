<script is:inline>
  // 카테고리 섹션별 3중 필터링 및 칩 동기화 스크립트
  (function() {
    const searchInput = document.getElementById('explore-search-input');
    const clearSearchBtn = document.getElementById('btn-clear-search');
    const areaSelect = document.getElementById('filter-area');
    const categorySelect = document.getElementById('filter-category');
    const companionSelect = document.getElementById('filter-companion');
    const catChips = document.querySelectorAll('[data-cat-chip]');
    const resetBtn = document.getElementById('btn-reset-filters');
    const resetEmptyBtn = document.getElementById('btn-reset-filters-empty');
    const matchingCountEl = document.getElementById('matching-count');
    const noResultsBox = document.getElementById('no-results-box');
    const catSections = document.querySelectorAll('[data-category-section]');

    function syncCatChips(selectedCat) {
      catChips.forEach(chip => {
        const val = chip.getAttribute('data-cat-chip');
        chip.classList.toggle('active', val === selectedCat);
      });
    }

    function applyFilters() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      const area = areaSelect?.value || 'all';
      const cat = categorySelect?.value || 'all';
      const comp = companionSelect?.value || 'all';

      if (clearSearchBtn) clearSearchBtn.hidden = !query;
      syncCatChips(cat);

      let totalMatched = 0;

      catSections.forEach(sec => {
        const secId = sec.getAttribute('data-category-section') || '';
        const cards = sec.querySelectorAll('.place-card');
        let secMatched = 0;

        cards.forEach(card => {
          const cardArea = card.getAttribute('data-area') || '';
          const cardCat = card.getAttribute('data-category') || '';
          const cardComps = (card.getAttribute('data-companions') || '').split(',');
          const textContent = card.textContent.toLowerCase();

          const matchArea = area === 'all' || cardArea === area;
          const matchCat = cat === 'all' || cardCat === cat;
          const matchComp = comp === 'all' || cardComps.includes(comp);
          const matchQuery = !query || textContent.includes(query);

          const visible = matchArea && matchCat && matchComp && matchQuery;
          if (visible) {
            card.style.display = '';
            secMatched++;
            totalMatched++;
          } else {
            card.style.display = 'none';
          }
        });

        // 해당 카테고리 섹션 내에 표시할 카드가 있으면 섹션 노출, 0개면 섹션 전체 숨김
        const secCountEl = sec.querySelector(`[data-sec-count="${secId}"]`);
        if (secCountEl) secCountEl.textContent = secMatched;

        if (secMatched > 0) {
          sec.removeAttribute('hidden');
        } else {
          sec.setAttribute('hidden', 'true');
        }
      });

      if (matchingCountEl) matchingCountEl.textContent = totalMatched;
      if (noResultsBox) {
        if (totalMatched === 0) {
          noResultsBox.removeAttribute('hidden');
        } else {
          noResultsBox.setAttribute('hidden', 'true');
        }
      }
    }

    function resetAll() {
      if (searchInput) searchInput.value = '';
      if (areaSelect) areaSelect.value = 'all';
      if (categorySelect) categorySelect.value = 'all';
      if (companionSelect) companionSelect.value = 'all';
      applyFilters();
    }

    catChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const val = chip.getAttribute('data-cat-chip') || 'all';
        if (categorySelect) {
          categorySelect.value = val;
          applyFilters();
          window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
        }
      });
    });

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchInput.focus();
        applyFilters();
      });
    }
    if (areaSelect) areaSelect.addEventListener('change', () => { applyFilters(); window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); });
    if (categorySelect) categorySelect.addEventListener('change', () => { applyFilters(); window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); });
    if (companionSelect) companionSelect.addEventListener('change', () => { applyFilters(); window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); });
    if (resetBtn) resetBtn.addEventListener('click', () => { resetAll(); window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); });
    if (resetEmptyBtn) resetEmptyBtn.addEventListener('click', () => { resetAll(); window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); });
  })();
</script>
