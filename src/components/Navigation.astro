---
const tabs = [
  { id: 'overview', label: '첫화면·도시', shortLabel: '첫화면', icon: '🏠', sub: '스토리포털·부산비교·6대구역' },
  { id: 'stories', label: '미식·역사 이야기', shortLabel: '역사이야기', icon: '📖', sub: '프롤로그~6장·화보스토리' },
  { id: 'december', label: '12월·연말연시', shortLabel: '12월특집', icon: '🎄', sub: '코모다루술통·그라코로·해넘이' },
  { id: 'explore', label: '맛집·찻집 도감', shortLabel: '맛집·찻집', icon: '🍽️', sub: '62곳·원조노포·5대미식' },
  { id: 'spots', label: '명소·쇼핑·명품', shortLabel: '명소·명품', icon: '🛍️', sub: '24곳·가챠·문구·가방·식도' },
  { id: 'survival', label: '초보 생존·사투리', shortLabel: '생존·사투리', icon: '🚇', sub: '공항·교통·예절·음성방언' }
];
---

<!-- 태블릿 & 데스크톱 상단 나무 명패(木札) 6대 탭바 -->
<nav class="desktop-nav" aria-label="메인 네비게이션">
  <div class="container">
    <div class="kifuda-tab-bar" role="tablist">
      {tabs.map((tab) => (
        <button
          type="button"
          id={`tab-${tab.id}`}
          role="tab"
          data-tab={tab.id}
          class={`kifuda-tab ${tab.id === 'overview' ? 'active' : ''}`}
          aria-selected={tab.id === 'overview'}
          aria-controls={`panel-${tab.id}`}
        >
          <span class="tab-icon">{tab.icon}</span>
          <div class="tab-label-group">
            <strong class="tab-title">{tab.label}</strong>
            <span class="tab-sub">{tab.sub}</span>
          </div>
        </button>
      ))}
    </div>
  </div>
</nav>

<!-- 모바일 하단 고정 6대 탭바 -->
<nav class="mobile-bottom-nav" aria-label="모바일 하단 네비게이션">
  <div class="mobile-tabs-wrap" role="tablist">
    {tabs.map((tab) => (
      <button
        type="button"
        role="tab"
        data-tab={tab.id}
        class={`mobile-tab-btn ${tab.id === 'overview' ? 'active' : ''}`}
        aria-selected={tab.id === 'overview'}
        aria-controls={`panel-${tab.id}`}
      >
        <span class="m-icon">{tab.icon}</span>
        <span class="m-label">{tab.shortLabel}</span>
      </button>
    ))}
  </div>
</nav>

<style>
  /* 태블릿 & 데스크톱 나무 명패 (키후다) 탭바 — 스크롤 시 화면 최상단(top: 0)에 오차 없이 밀착 */
  .desktop-nav {
    display: none;
    background: rgba(239, 232, 218, 0.97);
    backdrop-filter: blur(10px);
    border-top: 3px solid #1E293B;
    border-bottom: 2px solid #D6C7B2;
    padding: 9px 0;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
      position: sticky;
      top: 0;
      z-index: 50;
    }
  }

  .kifuda-tab-bar {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 6px;
  }

  @media (min-width: 1150px) {
    .kifuda-tab-bar {
      gap: 10px;
    }
  }

  .kifuda-tab {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 8px 4px;
    background: #F7EFE3;
    border: 1.5px solid #C8B297;
    border-radius: 8px;
    box-shadow: 0 2px 4px rgba(140, 83, 27, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.6);
    color: #4A3B32;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    text-align: center;
  }

  @media (min-width: 1180px) {
    .kifuda-tab {
      flex-direction: row;
      justify-content: flex-start;
      gap: 8px;
      padding: 9px 11px;
      text-align: left;
    }
  }

  .kifuda-tab:hover {
    background: #FAF4EB;
    border-color: var(--color-wood-dark);
    transform: translateY(-1px);
  }

  .kifuda-tab.active {
    background: #FFFFFF;
    border-color: var(--color-vermilion);
    box-shadow: 0 4px 12px rgba(214, 59, 34, 0.15), inset 0 2px 0 var(--color-vermilion);
    color: var(--color-vermilion-text);
  }

  .tab-icon {
    font-size: 1.15rem;
    line-height: 1;
    flex-shrink: 0;
  }

  @media (min-width: 1180px) {
    .tab-icon {
      font-size: 1.25rem;
    }
  }

  .tab-label-group {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .tab-title {
    font-size: 0.8rem;
    font-weight: 800;
    line-height: 1.25;
    white-space: nowrap;
  }

  @media (min-width: 1180px) {
    .tab-title {
      font-size: 0.88rem;
    }
  }

  .tab-sub {
    display: none;
    font-size: 0.68rem;
    color: #78716C;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 1180px) {
    .tab-sub {
      display: block;
    }
  }

  .kifuda-tab.active .tab-sub {
    color: #B52812;
    opacity: 0.85;
  }

  /* 모바일 하단 고정 6대 탭바 */
  .mobile-bottom-nav {
    display: block;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(10px);
    border-top: 1px solid #E2DDD3;
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.06);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  @media (min-width: 768px) {
    .mobile-bottom-nav {
      display: none;
    }
  }

  .mobile-tabs-wrap {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    height: 60px;
  }

  .mobile-tab-btn {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    color: #64748B;
    transition: all 0.15s ease;
  }

  .mobile-tab-btn.active {
    color: var(--color-vermilion);
    font-weight: 800;
  }

  .m-icon {
    font-size: 1.12rem;
    line-height: 1;
  }

  .m-label {
    font-size: 0.65rem;
    letter-spacing: -0.4px;
    white-space: nowrap;
  }
</style>

<script is:inline>
  // 6대 메인 탭 + 내 찜 바구니 전환 및 최상단 즉시 이동 제어
  (function() {
    let currentTab = 'overview';
    const validTabs = ['overview', 'december', 'stories', 'explore', 'spots', 'survival', 'picks'];

    function initTabFromUrl() {
      const urlParams = new URLSearchParams(window.location.search);
      const tabParam = urlParams.get('tab');
      if (tabParam && validTabs.includes(tabParam)) {
        return tabParam;
      }
      if (urlParams.get('picks')) {
        return 'picks';
      }
      return 'overview';
    }

    function switchTab(targetTabId, updateHistory = true) {
      if (!targetTabId || !validTabs.includes(targetTabId)) return;

      // 1. 탭 패널 표시/숨김 토글
      const panels = document.querySelectorAll('.tab-panel');
      panels.forEach(panel => {
        if (panel.id === `panel-${targetTabId}`) {
          panel.classList.remove('hidden-panel');
          panel.removeAttribute('hidden');
        } else {
          panel.classList.add('hidden-panel');
          panel.setAttribute('hidden', 'true');
        }
      });

      // 2. 네비게이션 버튼 활성화 클래스 토글
      const navButtons = document.querySelectorAll('[data-tab]');
      navButtons.forEach(btn => {
        const matches = btn.getAttribute('data-tab') === targetTabId;
        btn.classList.toggle('active', matches);
        btn.setAttribute('aria-selected', matches ? 'true' : 'false');
      });

      currentTab = targetTabId;

      // 3. URL 업데이트 (?tab=)
      if (updateHistory) {
        const url = new URL(window.location.href);
        url.searchParams.set('tab', targetTabId);
        window.history.pushState({ tab: targetTabId }, '', url.toString());
      }

      // 4. 새 탭 이동 시 항상 페이지 최상단(0px)으로 즉시 이동
      window.scrollTo({
        top: 0,
        left: 0,
        behavior: 'instant'
      });
      document.documentElement.scrollTop = 0;
      document.body.scrollTop = 0;

      // 탭 변경 이벤트 디스패치
      window.dispatchEvent(new CustomEvent('osaka_tab_change', { detail: { tab: targetTabId } }));
    }

    document.addEventListener('click', (e) => {
      // 1) 스토리 페이지에서 특정 가게 카드로 점프 (explore 또는 spots 탭의 #card-{id})
      const jumpPlaceBtn = e.target.closest('[data-jump-place]');
      if (jumpPlaceBtn) {
        e.preventDefault();
        const placeId = jumpPlaceBtn.getAttribute('data-jump-place');
        if (!placeId) return;
        const targetCard = document.getElementById('card-' + placeId);
        if (!targetCard) return;

        const isSpot = targetCard.closest('#panel-spots') !== null;
        switchTab(isSpot ? 'spots' : 'explore');

        if (isSpot && window.osakaResetSpotsFilters) {
          window.osakaResetSpotsFilters();
        } else if (!isSpot && window.osakaResetExploreFilters) {
          window.osakaResetExploreFilters();
        }

        setTimeout(() => {
          document.querySelectorAll('.place-card.jump-highlight').forEach(el => el.classList.remove('jump-highlight'));
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetCard.classList.add('jump-highlight');
          setTimeout(() => {
            targetCard.classList.remove('jump-highlight');
          }, 3200);
        }, 80);
        return;
      }

      // 2) 도감·첫화면에서 특정 스토리 챕터로 점프 (stories 탭의 해당 챕터)
      const jumpStoryBtn = e.target.closest('[data-jump-story]');
      if (jumpStoryBtn) {
        e.preventDefault();
        const storyId = jumpStoryBtn.getAttribute('data-jump-story');
        switchTab('stories');
        if (storyId && window.osakaSelectStoryChapter) {
          setTimeout(() => {
            window.osakaSelectStoryChapter(storyId, true);
          }, 50);
        }
        return;
      }

      // 3) 일반 탭 버튼 전환
      const tabBtn = e.target.closest('[data-tab]');
      if (tabBtn) {
        e.preventDefault();
        const targetTab = tabBtn.getAttribute('data-tab');
        if (targetTab) {
          switchTab(targetTab);
        }
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      const initialTab = initTabFromUrl();
      switchTab(initialTab, false);
    });

    window.addEventListener('popstate', (e) => {
      const stateTab = e.state?.tab || initTabFromUrl();
      switchTab(stateTab, false);
    });

    window.osakaSwitchTab = switchTab;
  })();
</script>
