    overflow-wrap: anywhere;
  }

  .opt-ko {
    font-size: 0.8rem;
    color: #64748B;
    margin-top: 2px;
  }

  .modal-footer {
    background: #F8FAFC;
    border-top: 1px solid #E2E8F0;
    padding: 10px 16px;
    flex-shrink: 0;
  }

  .btn-close-bottom {
    width: 100%;
    padding: 10px;
    border-radius: 8px;
    background: #1E293B;
    color: #FFFFFF;
    font-size: 0.95rem;
    font-weight: 600;
  }
</style>

<script is:inline>
  (function() {
    const overlay = document.getElementById('driver-modal-overlay');
    const modalContent = document.getElementById('driver-modal-content');
    const closeBtn = document.getElementById('close-driver-modal');
    const closeBottomBtn = document.getElementById('close-driver-modal-btn');
    const tabButtons = document.querySelectorAll('[data-modal-tab]');
    const tabPanes = document.querySelectorAll('.modal-tab-pane');
    let lastFocusedEl = null;

    function selectModalTab(targetTab) {
      tabButtons.forEach(b => {
        const active = b.getAttribute('data-modal-tab') === targetTab;
        b.classList.toggle('active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      tabPanes.forEach(p => {
        p.classList.toggle('active', p.id === `modal-tab-${targetTab}`);
      });
      if (modalContent) modalContent.scrollTop = 0;
    }

    function openModalWithPlace(placeId) {
      const placesList = window.__OSAKA_PLACES_DATA__ || [];
      const place = placesList.find(p => p.id === placeId) || placesList[0];
      if (!place) return;

      lastFocusedEl = document.activeElement instanceof HTMLElement ? document.activeElement : null;

      // 데이터 주입 (안전한 DOM API 사용)
      const nameJaEl = document.getElementById('modal-place-name-ja');
      const nameKoEl = document.getElementById('modal-place-name-ko');
      const addrJaEl = document.getElementById('modal-place-address-ja');
      const addrKoEl = document.getElementById('modal-place-address-ko');
      const phoneEl = document.getElementById('modal-place-phone');
      const hoursEl = document.getElementById('modal-place-hours');
      const taxiNoteEl = document.getElementById('modal-place-taxi-note');
      const fingerContainer = document.getElementById('modal-finger-order-container');

      const fullNameJa = [place.nameJa, place.branchJa].filter(Boolean).join(' ');
      if (nameJaEl) nameJaEl.textContent = fullNameJa;
      if (nameKoEl) {
        const branchLabel = place.branchKo || place.areaLabel;
        nameKoEl.textContent = /[()]/.test(branchLabel)
          ? `${place.nameKo} — ${branchLabel}`
          : `${place.nameKo} (${branchLabel})`;
      }
      if (addrJaEl) addrJaEl.textContent = place.addressJa || '大阪府大阪市中央区';
      if (addrKoEl) addrKoEl.textContent = place.addressKo || '';
      if (phoneEl) phoneEl.textContent = place.phone || '-';
      if (hoursEl) hoursEl.textContent = place.openHours || '-';

      if (taxiNoteEl) {
        taxiNoteEl.textContent = '';
        const jaLine = document.createTextNode(
          place.taxiNote || '近くの大きな通りでおろしていただいても大丈夫です。'
        );
        const br = document.createElement('br');
        const subSpan = document.createElement('span');
        subSpan.className = 'korean-sub';
        subSpan.textContent = '골목 진입이 어려우면 근처 큰길가에서 내려주셔도 됩니다.';
        taxiNoteEl.appendChild(jaLine);
        taxiNoteEl.appendChild(br);
        taxiNoteEl.appendChild(subSpan);
      }

      // 추천 메뉴 리스트 주입
      if (fingerContainer) {
        fingerContainer.textContent = '';
        const items = place.fingerOrderItems || [
          { nameJa: place.signatureMenu, nameKo: place.signatureMenu }
        ];
        items.forEach(item => {
          const div = document.createElement('div');
          div.className = 'signature-item';
          const textWrap = document.createElement('div');
          textWrap.style.minWidth = '0';
          const jaDiv = document.createElement('div');
          jaDiv.className = 'sig-ja';
          jaDiv.textContent = item.nameJa || '';
          const koDiv = document.createElement('div');
          koDiv.className = 'sig-ko';
          koDiv.textContent = item.nameKo || '';
          textWrap.appendChild(jaDiv);
          textWrap.appendChild(koDiv);
          const handSpan = document.createElement('span');
          handSpan.style.fontSize = '1.4rem';
          handSpan.style.flexShrink = '0';
          handSpan.textContent = '👉';
          div.appendChild(textWrap);
          div.appendChild(handSpan);
          fingerContainer.appendChild(div);
        });
      }

      // 주소 복사 버튼 갱신
      const copyBtn = document.getElementById('btn-copy-address');
      if (copyBtn) {
        copyBtn.textContent = '📋 일본어 주소 & 상호 복사';
        copyBtn.onclick = async () => {
          const hasValidPhone = place.phone && place.phone !== '-';
          const textToCopy = hasValidPhone
            ? `${fullNameJa}\n${place.addressJa}\nTEL: ${place.phone}`
            : `${fullNameJa}\n${place.addressJa}`;
          try {
            await navigator.clipboard.writeText(textToCopy);
            copyBtn.textContent = '✅ 복사 완료!';
            setTimeout(() => {
              copyBtn.textContent = '📋 일본어 주소 & 상호 복사';
            }, 1800);
          } catch(e) {
            alert(textToCopy);
          }
        };
      }

      // 항상 첫 번째 탭(택시)으로 초기화 후 모달 표시
      selectModalTab('taxi');
      overlay.removeAttribute('hidden');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.classList.add('modal-open');
      if (closeBtn) closeBtn.focus();
    }

    function closeModal() {
      overlay.setAttribute('hidden', 'true');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('modal-open');
      if (lastFocusedEl && typeof lastFocusedEl.focus === 'function') {
        lastFocusedEl.focus();
        lastFocusedEl = null;
      }
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (closeBottomBtn) closeBottomBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal();
    });

    // 탭 전환
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-modal-tab');
        if (targetTab) selectModalTab(targetTab);
      });
    });

    // 외부 버튼 클릭 이벤트 위임
    document.addEventListener('click', (e) => {
      const openBtn = e.target.closest('[data-open-driver-modal]');
      if (openBtn) {
        e.preventDefault();
        const placeId = openBtn.getAttribute('data-open-driver-modal');
        openModalWithPlace(placeId);
      }
    });

    // ESC 키로 닫기
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hasAttribute('hidden')) {
        closeModal();
      }
    });
  })();
</script>
