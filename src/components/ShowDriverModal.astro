    font-size: 0.75rem;
    font-weight: 500;
    color: #64748B;
  }

  .addr-value {
    font-size: 1.15rem;
    font-weight: 600;
    color: #0F172A;
    line-height: 1.35;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  .addr-sub-ko {
    font-size: 0.84rem;
    color: #475569;
    line-height: 1.45;
  }

  .addr-value.phone {
    font-family: monospace;
    font-size: 1.25rem;
    color: #2563EB;
