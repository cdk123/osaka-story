---
import { places } from '../data/places';

const modalPlacesData = places.map(p => ({
  id: p.id,
  nameKo: p.nameKo,
  nameJa: p.nameJa,
  branchKo: p.branchKo,
  branchJa: p.branchJa,
  area: p.area,
  areaLabel: p.areaLabel,
  addressJa: p.addressJa,
  addressKo: p.addressKo,
  phone: p.phone,
  openHours: p.openHours,
  taxiNote: p.taxiNote,
  signatureMenu: p.signatureMenu,
  fingerOrderItems: p.fingerOrderItems
}));
---

<div id="driver-modal-overlay" class="modal-overlay" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-place-name-ko">
  <div class="modal-window">
    <!-- 모달 상단 헤더 -->
    <header class="modal-header">
      <div class="modal-tabs" role="tablist">
        <button type="button" class="m-tab-btn active" role="tab" aria-selected="true" aria-controls="modal-tab-taxi" data-modal-tab="taxi">
          <span>🚕 택시 기사님</span>
        </button>
        <button type="button" class="m-tab-btn" role="tab" aria-selected="false" aria-controls="modal-tab-entrance" data-modal-tab="entrance">
          <span>🚪 식당 입구·좌석</span>
        </button>
        <button type="button" class="m-tab-btn" role="tab" aria-selected="false" aria-controls="modal-tab-order" data-modal-tab="order">
          <span>👉 손가락 주문</span>
        </button>
      </div>
      <button type="button" id="close-driver-modal" class="btn-close-modal" aria-label="닫기">
        ✕
      </button>
    </header>

    <!-- 모달 본문 영역 (순백 고대비 특대형 텍스트) -->
    <div class="modal-content" id="driver-modal-content">
      <!-- 1. 택시 탭 -->
      <section id="modal-tab-taxi" class="modal-tab-pane active" role="tabpanel">
        <div class="lead-phrase-box">
          <p class="japanese-lead">運転手さん、ここまでお願いします。</p>
          <span class="korean-lead">기사님, 여기로 가주세요.</span>
        </div>

        <div class="giant-destination-box">
          <div class="giant-name-ja" id="modal-place-name-ja">松阪牛焼肉 M 法善寺横丁店</div>
          <div class="giant-name-ko" id="modal-place-name-ko">마츠사카규 야키니쿠 M (호젠지 요코초 본점)</div>
        </div>

        <div class="address-card">
          <div class="addr-row">
            <span class="addr-label">住所 (주소)</span>
            <span class="addr-value" id="modal-place-address-ja">大阪府大阪市中央区難波1-1-19</span>
            <span class="addr-sub-ko" id="modal-place-address-ko">오사카시 주오구 난바 1-1-19</span>
          </div>
          <div class="addr-row">
            <span class="addr-label">電話 (전화)</span>
            <span class="addr-value phone" id="modal-place-phone">06-6211-2917</span>
          </div>
          <div class="addr-row">
            <span class="addr-label">営業時間 (영업시간)</span>
            <span class="addr-sub-ko" id="modal-place-hours">12:00~15:00 / 17:00~23:00</span>
          </div>
          <button type="button" id="btn-copy-address" class="btn-copy-addr">
            📋 일본어 주소 & 상호 복사
          </button>
        </div>

        <div class="driver-note-box" id="modal-taxi-note-container">
          <span class="driver-note-icon">💡</span>
          <p class="driver-note-text" id="modal-place-taxi-note">
            近くの大きな通りでおろしていただいても大丈夫です。
            <br /><span class="korean-sub">골목 진입이 어려우면 근처 큰길가에서 내려주셔도 됩니다.</span>
          </p>
        </div>

        <!-- 택시 승차 정원 주의 배너 -->
        <div class="taxi-family-warning">
          <strong class="warn-title">⚠️ 일본 택시 탑승 인원 안내</strong>
          <p class="warn-desc">
            일본 일반 택시(도요타 재팬택시/크라운)는 <strong>최대 4인까지만 탑승 가능</strong>합니다. 5인 이상 일행은 <strong>택시 2대로 나누어 탑승</strong>하시거나, Uber 앱에서 <strong>Uber XL(대형 밴)</strong>을 호출하세요.
          </p>
        </div>
      </section>

      <!-- 2. 식당 입구 탭 (입장 & 자리 분리 치트키) -->
      <section id="modal-tab-entrance" class="modal-tab-pane" role="tabpanel">
        <div class="phrase-card">
          <div class="phrase-header">
            <span class="badge-role">예약 없이 현장 입장 문의</span>
          </div>
          <p class="phrase-ja-giant">予約していないのですが、今入れますか？</p>
          <p class="phrase-pronounce">요야쿠 시테이나이노데스가, 이마 하이레마스카?</p>
          <p class="phrase-meaning">예약하지 않았는데, 지금 들어갈 수 있나요? (손가락으로 인원수 표시)</p>
        </div>

        <div class="phrase-card highlight-card">
          <div class="phrase-header">
            <span class="badge-role golden">★ 초강력 웨이팅 단축 치트키</span>
          </div>
          <p class="phrase-ja-giant">席が分かれても大丈夫です。</p>
          <p class="phrase-pronounce">세키가 와카레테모 다이죠-부데스.</p>
          <p class="phrase-meaning">자리가 서로 나뉘어 앉아도 괜찮습니다!</p>
          <div class="cheat-explain">
            💡 다인원 한 테이블은 대기가 길지만, 따로 앉아도 괜찮다고 보여주면 5분 만에 입장하는 경우가 많습니다!
          </div>
        </div>

        <div class="phrase-card">
          <div class="phrase-header">
            <span class="badge-role">입식 테이블석 요청</span>
          </div>
          <p class="phrase-ja-giant">できればテーブル席（または掘りごたつ）でお願いします。</p>
          <p class="phrase-pronounce">데키레바 테-부루세키(마타와 호리고타츠)데 오네가이시마스.</p>
          <p class="phrase-meaning">가능하면 좌식 방바닥 대신 입식 테이블석(또는 다리를 내리는 좌석)으로 부탁드립니다.</p>
        </div>

        <div class="phrase-card">
          <div class="phrase-header">
            <span class="badge-role">예약 확인</span>
          </div>
          <p class="phrase-ja-giant">予約した者です。予約画面を見せます。</p>
          <p class="phrase-pronounce">요야쿠시타 모노데스. 요야쿠 가멘오 미세마스.</p>
          <p class="phrase-meaning">예약한 사람입니다. 예약 확인 화면을 보여드리겠습니다.</p>
        </div>
      </section>

      <!-- 3. 손가락 주문판 탭 -->
      <section id="modal-tab-order" class="modal-tab-pane" role="tabpanel">
        <div class="order-lead-box">
          <p class="phrase-ja-giant">これをお願いします。</p>
          <span class="korean-lead">손가락으로 메뉴를 가리키며: “이걸로 주세요.”</span>
        </div>

        <!-- 해당 식당의 추천 메뉴 리스트 -->
        <div class="signature-order-list" id="modal-finger-order-container">
          <!-- 동적 주입 -->
        </div>

        <!-- 옵션 요청 (날계란, 와사비, 간 조절 등) -->
        <div class="order-options-group">
          <h4 class="options-title">자주 쓰는 실전 요청 카드 (손가락으로 콕 짚기)</h4>
          
          <div class="option-item-card">
            <div class="opt-ja">生卵は別皿でお願いします。</div>
            <div class="opt-ko">날계란은 다른 접시에 따로 담아주세요. (카레/우동 등)</div>
          </div>

          <div class="option-item-card">
            <div class="opt-ja">わさび抜きでお願いします。</div>
            <div class="opt-ko">와사비(고추냉이)는 빼고 만들어 주세요.</div>
          </div>

          <div class="option-item-card">
            <div class="opt-ja">わさびは別添えでお願いします。</div>
            <div class="opt-ko">와사비는 접시 옆에 따로 담아주세요.</div>
          </div>

          <div class="option-item-card">
            <div class="opt-ja">味を少し薄めにしていただけますか？</div>
            <div class="opt-ko">음식 간을 조금 덜 짜게(싱겁게) 해주실 수 있나요?</div>
          </div>

          <div class="option-item-card">
            <div class="opt-ja">お冷（お水）をいただけますか？</div>
            <div class="opt-ko">시원한 물 좀 더 주시겠어요?</div>
          </div>

          <div class="option-item-card">
            <div class="opt-ja">お会計をお願いします。（別々で）</div>
            <div class="opt-ko">계산 부탁드립니다. (영수증 따로)</div>
          </div>
        </div>
      </section>
    </div>

    <!-- 모달 하단 닫기 바 -->
    <footer class="modal-footer">
      <button type="button" class="btn-close-bottom" id="close-driver-modal-btn">
        화면 닫기
      </button>
    </footer>
  </div>
</div>

<!-- 장소 데이터 클라이언트 스크립트용 인라인 JSON -->
<script define:vars={{ placesData: modalPlacesData }}>
  window.__OSAKA_PLACES_DATA__ = placesData;
</script>

<style>
  .modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }

  .modal-overlay[hidden] {
    display: none !important;
  }

  .modal-window {
    width: 100%;
    max-width: 640px;
    max-height: 92vh;
    background: #FFFFFF;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: #000000;
  }

  .modal-header {
    background: #1E293B;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    flex-shrink: 0;
  }

  .modal-tabs {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
  }

  .m-tab-btn {
    padding: 6px 3px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: -0.4px;
    color: #CBD5E1;
    background: rgba(255, 255, 255, 0.08);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: all 0.15s ease;
  }

  @media (min-width: 520px) {
    .modal-header {
      padding: 10px 14px;
      gap: 8px;
    }
    .modal-tabs {
      display: flex;
      gap: 6px;
    }
    .m-tab-btn {
      padding: 6px 12px;
      font-size: 0.84rem;
      letter-spacing: 0;
    }
  }

  .m-tab-btn.active {
    color: #FFFFFF;
    background: var(--color-vermilion);
  }

  .btn-close-modal {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .modal-content {
    flex: 1;
    overflow-y: auto;
    padding: 20px 16px;
    -webkit-overflow-scrolling: touch;
  }

  .modal-tab-pane {
    display: none;
    flex-direction: column;
    gap: 16px;
  }

  .modal-tab-pane.active {
    display: flex;
  }

  /* 택시 탭 특대형 텍스트 */
  .lead-phrase-box {
    background: #F1F5F9;
    border-left: 5px solid var(--color-vermilion);
    padding: 12px 14px;
    border-radius: 0 8px 8px 0;
  }

  .japanese-lead {
    font-size: 1.35rem;
    font-weight: 700;
    color: #000000;
    line-height: 1.3;
  }

  .korean-lead {
    font-size: 0.85rem;
    color: #475569;
    display: block;
    margin-top: 2px;
  }

  .giant-destination-box {
    background: #FFFFFF;
    border: 2px solid #000000;
    padding: 18px 14px;
    border-radius: 12px;
    text-align: center;
  }

  .giant-name-ja {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 700;
    color: #000000;
    line-height: 1.25;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .giant-name-ko {
    font-size: 1rem;
    font-weight: 500;
    color: #475569;
    margin-top: 6px;
  }

  .address-card {
    background: #F8FAFC;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .addr-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

