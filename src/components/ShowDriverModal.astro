    border: 1.5px solid #94A3B8;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    color: #1E293B;
    margin-top: 4px;
    transition: all 0.15s ease;
  }

  .btn-copy-addr:hover {
    background: #F1F5F9;
    border-color: #475569;
  }

  .driver-note-box {
    background: #FEF3C7;
    border: 1px solid #FCD34D;
    padding: 12px;
    border-radius: 8px;
    display: flex;
    gap: 8px;
    font-size: 0.95rem;
    color: #78350F;
    min-width: 0;
    max-width: 100%;
  }

  .driver-note-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .driver-note-text {
    font-weight: 600;
    line-height: 1.45;
    flex: 1;
    min-width: 0;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  :global(.korean-sub) {
    font-weight: 400;
    font-size: 0.82rem;
    color: #92400E;
  }

  .taxi-family-warning {
    background: #FEE2E2;
    border: 1.5px solid #F87171;
    border-radius: 10px;
    padding: 12px 14px;
  }

  .warn-title {
    color: #991B1B;
    font-size: 0.9rem;
    font-weight: 600;
    display: block;
    margin-bottom: 4px;
  }

  .warn-desc {
    font-size: 0.82rem;
    color: #7F1D1D;
    line-height: 1.5;
  }

  /* 식당 입구 탭 */
  .phrase-card {
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .phrase-card.highlight-card {
    border-color: var(--color-vermilion);
    background: #FFF5F5;
  }

  .badge-role {
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
    background: #E2E8F0;
    padding: 2px 8px;
    border-radius: 4px;
    align-self: flex-start;
  }

  .badge-role.golden {
    background: var(--color-vermilion);
    color: #FFFFFF;
  }

  .phrase-ja-giant {
    font-size: 1.5rem;
    font-weight: 700;
    color: #000000;
    line-height: 1.3;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  .phrase-pronounce {
    font-size: 0.88rem;
    font-weight: 500;
    color: #0284C7;
  }

  .phrase-meaning {
    font-size: 0.9rem;
    color: #334155;
  }

  .cheat-explain {
    background: #FFFFFF;
    border: 1px dashed #F87171;
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 0.8rem;
    color: #B91C1C;
    margin-top: 4px;
  }

  /* 손가락 주문 탭 */
  .order-lead-box {
    background: #F8FAFC;
    border: 2px solid #000000;
    border-radius: 10px;
    padding: 12px;
    text-align: center;
  }

  .signature-order-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.signature-item) {
    background: #F0FDF4;
    border: 1.5px solid #86EFAC;
    border-radius: 8px;
    padding: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  :global(.sig-ja) {
    font-size: 1.25rem;
    font-weight: 700;
    color: #14532D;
    line-height: 1.35;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  :global(.sig-ko) {
    font-size: 0.85rem;
    color: #15803D;
    margin-top: 3px;
  }

  .order-options-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
  }

  .options-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #334155;
  }

  .option-item-card {
    background: #FFFFFF;
    border: 1.5px solid #CBD5E1;
    border-radius: 8px;
    padding: 10px 12px;
  }

  .opt-ja {
    font-size: 1.15rem;
    font-weight: 700;
    color: #000000;
